<UserControl
    x:Class="YTMusicWP.Controls.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Named elements are x:FieldModifier="internal" because MainPage (Auth/Storage partials) still
         reads and writes them directly, e.g. SettingsPanel.LoginStatusText. -->

    <UserControl.Resources>
        <!-- Same implicit fonts as MainPage (page-level implicit styles are not guaranteed to reach inside a UserControl) -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MontserratRegular}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource MontserratRegular}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource MontserratMedium}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1A1A2E" Offset="0"/>
                <GradientStop Color="#0D0D0D" Offset="0.4"/>
                <GradientStop Color="#121212" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="20,15,15,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Settings" FontSize="26" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Customize your experience" FontSize="12" Foreground="#666" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Click="Close_Click" Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right" Width="40" Height="40" VerticalAlignment="Top">
                <Border Background="#1A1A1A" CornerRadius="20" Width="36" Height="36">
                    <Viewbox Width="14" Height="14"><Path Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12Z" Fill="#999"/></Viewbox>
                </Border>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,15,0,0">
            <StackPanel Margin="16,0,16,50">

                <!-- ═══════ ACCOUNT SECTION ═══════ -->
                <Border Background="#1A1A1A" CornerRadius="16" Margin="0,0,0,16" Padding="18,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#1DB954" CornerRadius="12" Width="28" Height="28" Margin="0,0,10,0">
                                <TextBlock Text="&#xE13D;" FontFamily="Segoe UI Symbol" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Account" FontSize="16" FontFamily="{StaticResource MontserratSemiBold}" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Hidden: OAuth credentials (auto-filled by app) -->
                        <Border Background="#1E1E1E" CornerRadius="10" Margin="0,0,0,10" Visibility="Collapsed">
                            <TextBox x:Name="ClientIdTextBox" x:FieldModifier="internal" PlaceholderText="Client ID..." Style="{StaticResource DarkTextBoxStyle}"/>
                        </Border>
                        <Border Background="#1E1E1E" CornerRadius="10" Margin="0,0,0,10" Visibility="Collapsed">
                            <TextBox x:Name="ClientSecretTextBox" x:FieldModifier="internal" PlaceholderText="Client Secret..." Style="{StaticResource DarkTextBoxStyle}"/>
                        </Border>

                        <!-- NOT LOGGED IN state -->
                        <StackPanel x:Name="AccountSignedOutPanel" x:FieldModifier="internal">
                            <TextBlock Text="Sign in to sync liked songs, playlists, and subscriptions." Foreground="#777" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap"/>
                            <Button Click="LoginCookie_Click" Style="{StaticResource CategoryButtonStyle}" Height="46" Margin="0,0,0,8">
                                <Border CornerRadius="12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#1DB954" Offset="0"/>
                                            <GradientStop Color="#1ED760" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE13D;" FontFamily="Segoe UI Symbol" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Sign in with Google" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                            <Button Click="LoginGoogle_Click" Style="{StaticResource CategoryButtonStyle}" Height="40">
                                <Border CornerRadius="12" Background="#333">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE15B;" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="#999" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Sign in with TV Code" FontFamily="{StaticResource MontserratSemiBold}" FontSize="13" Foreground="#999" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </StackPanel>

                        <!-- LOGGED IN state -->
                        <StackPanel x:Name="AccountSignedInPanel" x:FieldModifier="internal" Visibility="Collapsed">
                            <Border Background="#252525" CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#1DB954" CornerRadius="16" Width="32" Height="32" Margin="0,0,12,0">
                                        <TextBlock Text="✓" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="AccountUserName" x:FieldModifier="internal" Text="Signed In" FontSize="14" FontFamily="{StaticResource MontserratSemiBold}" Foreground="White"/>
                                        <TextBlock x:Name="LoginStatusText" x:FieldModifier="internal" Text="Synced" Foreground="#1DB954" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Other accounts / brand channels (rows built by MainPage.RenderAccountList; shown with 2+) -->
                            <StackPanel x:Name="AccountListSection" x:FieldModifier="internal" Visibility="Collapsed" Margin="0,0,0,4">
                                <TextBlock Text="Switch account" FontSize="12" Foreground="#999" Margin="2,0,0,8"/>
                                <StackPanel x:Name="AccountListPanel" x:FieldModifier="internal"/>
                            </StackPanel>

                            <Button Click="AddAccount_Click" Style="{StaticResource CategoryButtonStyle}" Margin="0,0,0,8" Height="42">
                                <Border Background="#252525" CornerRadius="12">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE109;" FontFamily="Segoe UI Symbol" FontSize="15" Foreground="#1DB954" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Add account" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Button>

                            <Button x:Name="SyncNowBtn" x:FieldModifier="internal" Click="SyncNow_Click" Style="{StaticResource CategoryButtonStyle}" Margin="0,0,0,8" Height="42">
                                <Border Background="#252525" CornerRadius="12">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE117;" FontFamily="Segoe UI Symbol" FontSize="15" Foreground="#1DB954" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Sync Now" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Button>

                            <Button Click="LogoutGoogle_Click" Style="{StaticResource CategoryButtonStyle}" Margin="0,0,0,0" Height="40">
                                <Border Background="#2A1215" CornerRadius="12">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="SignOutText" x:FieldModifier="internal" Text="Sign Out" FontFamily="{StaticResource MontserratSemiBold}" FontSize="13" Foreground="#FF6B6B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══════ REGION ═══════ -->

                <Border Background="#1A1A1A" CornerRadius="16" Margin="0,0,0,16" Padding="18,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#3B82F6" CornerRadius="12" Width="28" Height="28" Margin="0,0,10,0">
