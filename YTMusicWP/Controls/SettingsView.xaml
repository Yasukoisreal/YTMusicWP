                        </ComboBox>

                        <TextBlock Text="Language (affects titles &amp; labels)" Foreground="#777" FontSize="12" Margin="0,0,0,8"/>
                        <ComboBox x:Name="LanguageComboBox" x:FieldModifier="internal" Background="#252525" Foreground="White" BorderThickness="0" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Auto (match location)" Tag="AUTO"/>
                            <ComboBoxItem Content="Afrikaans" Tag="af"/>
