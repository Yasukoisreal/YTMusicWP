<UserControl
    x:Class="YTMusicWP.Controls.ShortsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Samples tab (YouTube Music "Samples"): full-screen music video clips, swipe up/down between them.
         MainPage.Shorts.cs drives it; named elements are x:FieldModifier="internal". -->

    <UserControl.Resources>
        <!-- Same implicit TextBlock font as MainPage (page-level implicit styles are not guaranteed to reach inside a UserControl) -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MontserratRegular}"/>
        </Style>
        <!-- Round translucent action button with a label underneath (right-hand column) -->
        <Style x:Key="SampleActionCircle" TargetType="Border">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="Background" Value="#4D000000"/>
        </Style>
        <Style x:Key="SampleActionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="Black" ManipulationMode="TranslateY" ManipulationDelta="Shorts_ManipulationDelta" ManipulationCompleted="Shorts_ManipulationCompleted">
        <!-- Video stage: blurred backdrop, then the video at its own aspect, poster on top (faded out once frames
             play). The clips are 360p landscape: filling the portrait screen zoomed them ~2.2x (blocky, "scratched")
             and made every frame a full-screen scale + blend, so they stutter-dropped frames. Letterboxed they are
             scaled ~1.3x, and the backdrop / dimming sit below the video, never blended over it.
             The MediaElement's own opacity is never animated so the video keeps the direct (hardware) render path.
             Moves with the finger while swiping. -->
        <Grid x:Name="SampleStage" x:FieldModifier="internal" Background="Black" Tapped="SampleStage_Tapped" SizeChanged="SampleStage_SizeChanged">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="SampleStageTransform" x:FieldModifier="internal" Y="0"/>
            </Grid.RenderTransform>
            <!-- Thumbnail decoded at ~24 px and stretched: a smooth blur for free -->
            <Image x:Name="SampleBackdrop" x:FieldModifier="internal" Stretch="UniformToFill" IsHitTestVisible="False"/>
            <Rectangle Fill="#8C000000" IsHitTestVisible="False"/>
            <MediaElement x:Name="SampleVideo" x:FieldModifier="internal" Stretch="Uniform" AutoPlay="False"
                          AreTransportControlsEnabled="False" AudioCategory="ForegroundOnlyMedia"/>
            <!-- Sized to the letterboxed video area by the code-behind (16:9 until the clip reports its size) -->
            <Rectangle x:Name="SamplePosterLayer" x:FieldModifier="internal" IsHitTestVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <Rectangle.Fill>
                    <ImageBrush x:Name="SamplePoster" x:FieldModifier="internal" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Readability gradients (top for the logo, bottom for the song card) -->
        <Rectangle Height="110" VerticalAlignment="Top" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#99000000" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Height="240" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#CC000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- YouTube Music logo, vector paths from YouTube_Music_2024.svg (wordmark white for the dark background) -->
        <Viewbox Height="24" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16,16,0,0" IsHitTestVisible="False">
            <Canvas Width="408.776" Height="139.79">
                <Path Fill="#FF0033" Data="m 69.895212,139.79042 c 38.582158,0 69.895208,-31.31305 69.895208,-69.895208 C 139.79042,31.313055 108.47737,0 69.895212,0 31.313055,0 0,31.313055 0,69.895212 0,108.47737 31.313055,139.79042 69.895212,139.79042 Z"/>
                <Path Stroke="White" StrokeThickness="5.37655" Data="m 110.21937,69.895212 c 0,22.279906 -18.044252,40.324158 -40.324158,40.324158 -22.27969,0 -40.324161,-18.044252 -40.324161,-40.324158 0,-22.27969 18.044471,-40.324161 40.324161,-40.324161 22.279906,0 40.324158,18.044471 40.324158,40.324161 z"/>
                <Path Fill="White" Data="M 95.433848,69.895212 55.109687,47.044854 V 92.74557 Z"/>
                <Canvas>
                    <Canvas.RenderTransform>
                        <ScaleTransform ScaleX="5.3765548" ScaleY="5.3765548"/>
                    </Canvas.RenderTransform>
                    <Path Fill="White" Data="m 30.112,21.8671 h 2.32 v -7.29 c 0,-2.04 -0.04,-4.21 -0.2,-7.10995 h 0.26 l 0.43,1.78 2.74,12.61995 h 2.36 l 2.69,-12.61995 0.47,-1.78 h 0.24 c -0.12,2.56995 -0.19,4.88995 -0.19,7.10995 v 7.29 h 2.33 V 5.06715 h -3.96 l -1.42,6.20995 c -0.6,2.58 -1.03,5.78 -1.28,7.41 h -0.19 c -0.18,-1.66 -0.63,-4.85 -1.22,-7.39 l -1.46,-6.22995 h -3.92 z"/>
                    <Path Fill="White" Data="m 48.202,22.0571 c 1.46,0 2.37,-0.61 3.12,-1.71 h 0.11 l 0.11,1.52 h 1.99 V 9.50715 h -2.64 v 9.92995 c -0.28,0.49 -0.93,0.85 -1.54,0.85 -0.77,0 -1.01,-0.61 -1.01,-1.63 V 9.50715 h -2.63 v 9.26995 c 0,2.01 0.58,3.28 2.49,3.28 z"/>
                    <Path Fill="White" Data="m 58.7536,22.1271 c 2.42,0 3.77,-1.07 3.77,-3.26 0,-1.99 -1,-2.8 -3.38,-4.42 -1.09,-0.72 -1.68,-1.17 -1.68,-2.23 0,-0.79 0.49,-1.21 1.38,-1.21 0.97,0 1.3,0.64 1.34,2.46 l 2.16,-0.12 c 0.18,-2.85 -0.84,-4.06995 -3.46,-4.06995 -2.48,0 -3.67,1.06995 -3.67,3.18995 0,1.96 0.93,2.85 2.68,4.07 1.55,1.07 2.4,1.74 2.4,2.63 0,0.73 -0.51,1.26 -1.4,1.26 -1.02,0 -1.6,-0.88 -1.5,-2.21 l -2.19,0.04 c -0.34,2.56 0.86,3.87 3.55,3.87 z"/>
                    <Path Fill="White" Data="m 65.387,7.93715 c 0.9,0 1.32,-0.3 1.32,-1.54 0,-1.16 -0.45,-1.52 -1.32,-1.52 -0.88,0 -1.31,0.32 -1.31,1.52 0,1.24 0.41,1.54 1.31,1.54 z m -1.22,13.92995 h 2.53 V 9.50715 h -2.53 z"/>
                    <Path Fill="White" Data="m 72.3428,22.0671 c 1.26,0 1.97,-0.1499 2.54,-0.69 0.85,-0.74 1.2,-1.89 1.14,-3.83 l -2.31,-0.12 c 0,2.12 -0.34,2.92 -1.33,2.92 -1.09,0 -1.27,-1.19 -1.27,-3.35 v -2.56 c 0,-2.36 0.23,-3.48 1.29,-3.48 0.88,0 1.23,0.74 1.23,3.1 l 2.29,-0.16 c 0.16,-1.69 -0.01,-3.07 -0.81,-3.84 -0.6,-0.55995 -1.49,-0.77995 -2.67,-0.77995 -3.03,0 -3.97,1.91995 -3.97,5.56995 v 1.69 c 0,3.65 0.71,5.53 3.87,5.53 z"/>
                </Canvas>
            </Canvas>
        </Viewbox>

        <!-- Loading / paused / message -->
        <ProgressRing x:Name="SampleLoading" x:FieldModifier="internal" IsActive="False" Width="44" Height="44" Foreground="White" IsHitTestVisible="False"/>
        <Border x:Name="SamplePausedIcon" x:FieldModifier="internal" Width="72" Height="72" CornerRadius="36" Background="#66000000" Visibility="Collapsed" IsHitTestVisible="False">
            <!-- Triangle nudged 2px right: its visual centre sits left of its bounding box -->
            <Viewbox Width="24" Height="28" Margin="4,0,0,0">
                <Path Stretch="Uniform" Data="M8,5.14V19.14L19,12.14L8,5.14Z" Fill="White"/>
            </Viewbox>
        </Border>
        <TextBlock x:Name="SampleMessage" x:FieldModifier="internal" Visibility="Collapsed" FontSize="14" Foreground="#DDDDDD" TextAlignment="Center" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0" IsHitTestVisible="False"/>

        <!-- Right-hand actions -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,10,92">
            <Button Click="Like_Click" Style="{StaticResource IconButtonStyle}" MinWidth="0" MinHeight="0" Margin="0,0,0,14">
                <StackPanel>
                    <Border Style="{StaticResource SampleActionCircle}">
                        <Viewbox Width="22" Height="22">
                            <Path Stretch="Uniform" x:Name="SampleLikeIcon" x:FieldModifier="internal" Fill="White" Data="M23,10C23,8.89 22.1,8 21,8H14.68L15.64,3.43C15.66,3.33 15.67,3.22 15.67,3.11C15.67,2.7 15.5,2.32 15.23,2.05L14.17,1L7.59,7.58C7.22,7.95 7,8.45 7,9V19A2,2 0 0,0 9,21H18C18.83,21 19.54,20.5 19.84,19.78L22.86,12.73C22.95,12.5 23,12.26 23,12V10M1,21H5V9H1V21Z"/>
                        </Viewbox>
                    </Border>
                    <TextBlock x:Name="SampleLikeText" x:FieldModifier="internal" Text="Like" Style="{StaticResource SampleActionLabel}"/>
                </StackPanel>
            </Button>
            <Button Click="Save_Click" Style="{StaticResource IconButtonStyle}" MinWidth="0" MinHeight="0" Margin="0,0,0,14">
                <StackPanel>
                    <Border Style="{StaticResource SampleActionCircle}">
                        <Viewbox Width="22" Height="22">
                            <Path Stretch="Uniform" Fill="White" Data="M3,16H10V14H3M18,14V10H16V14H12V16H16V20H18V16H22V14M14,6H3V8H14M14,10H3V12H14V10Z"/>
                        </Viewbox>
                    </Border>
                    <TextBlock x:Name="SampleSaveText" x:FieldModifier="internal" Text="Save" Style="{StaticResource SampleActionLabel}"/>
                </StackPanel>
            </Button>
            <Button Click="Share_Click" Style="{StaticResource IconButtonStyle}" MinWidth="0" MinHeight="0" Margin="0,0,0,14">
                <StackPanel>
                    <Border Style="{StaticResource SampleActionCircle}">
                        <Viewbox Width="22" Height="22">
                            <Path Stretch="Uniform" Fill="White" Data="M21,12L14,5V9C7,10 4,15 3,20C5.5,16.5 9,14.9 14,14.9V19L21,12Z"/>
                        </Viewbox>
                    </Border>
                    <TextBlock x:Name="SampleShareText" x:FieldModifier="internal" Text="Share" Style="{StaticResource SampleActionLabel}"/>
                </StackPanel>
            </Button>
            <Button Click="Play_Click" Style="{StaticResource IconButtonStyle}" MinWidth="0" MinHeight="0">
                <StackPanel>
                    <Border Style="{StaticResource SampleActionCircle}">
                        <Viewbox Width="17" Height="20" Margin="3,0,0,0">
                            <Path Stretch="Uniform" Fill="White" Data="M8,5.14V19.14L19,12.14L8,5.14Z"/>
                        </Viewbox>
                    </Border>
                    <TextBlock x:Name="SamplePlayText" x:FieldModifier="internal" Text="Play" Style="{StaticResource SampleActionLabel}"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Song card -->
        <Grid VerticalAlignment="Bottom" Margin="12,0,6,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Background="Transparent" Tapped="SongBar_Tapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Rectangle Width="52" Height="52" RadiusX="4" RadiusY="4">
                    <Rectangle.Fill>
                        <ImageBrush x:Name="SampleCover" x:FieldModifier="internal" Stretch="UniformToFill"/>
                    </Rectangle.Fill>
                </Rectangle>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,6,0">
                    <TextBlock x:Name="SampleTitle" x:FieldModifier="internal" FontSize="16" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SampleArtist" x:FieldModifier="internal" FontSize="13" Foreground="#CCCCCC" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
            <Button Grid.Column="1" Click="More_Click" Style="{StaticResource IconButtonStyle}" Width="44" Height="44" MinWidth="0" MinHeight="0" VerticalAlignment="Center">
                <Viewbox Width="20" Height="20">
                    <Path Stretch="Uniform" Fill="White" Data="M16,12A2,2 0 0,1 18,10A2,2 0 0,1 20,12A2,2 0 0,1 18,14A2,2 0 0,1 16,12M10,12A2,2 0 0,1 12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12M4,12A2,2 0 0,1 6,10A2,2 0 0,1 8,12A2,2 0 0,1 6,14A2,2 0 0,1 4,12Z"/>
                </Viewbox>
            </Button>
        </Grid>

        <!-- Clip progress -->
        <ProgressBar x:Name="SampleProgress" x:FieldModifier="internal" VerticalAlignment="Bottom" Height="2" Minimum="0" Maximum="1" Value="0"
                     Foreground="White" Background="#33FFFFFF" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
