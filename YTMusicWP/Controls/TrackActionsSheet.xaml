<UserControl
    x:Class="YTMusicWP.Controls.TrackActionsSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Same implicit TextBlock font as MainPage (page-level implicit styles are not guaranteed to reach inside a UserControl) -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MontserratRegular}"/>
        </Style>

        <Storyboard x:Name="SlideUpStoryboard">
            <DoubleAnimation Storyboard.TargetName="BottomSheetTransform" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="SlideDownStoryboard" Completed="SlideDownStoryboard_Completed">
            <DoubleAnimation Storyboard.TargetName="BottomSheetTransform" Storyboard.TargetProperty="Y" To="800" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="#A0000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" Click="Close_Click" Style="{StaticResource IconButtonStyle}" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Border Grid.Row="1" Background="#252525" CornerRadius="20,20,0,0" Padding="0,10,0,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="BottomSheetTransform" Y="800"/>
            </Border.RenderTransform>
            <StackPanel Tapped="Content_Tapped">
                <!-- Drag handle -->
                <Rectangle Width="36" Height="4" Fill="#666666" RadiusX="2" RadiusY="2" Margin="0,10,0,10" HorizontalAlignment="Center"/>
                <Grid Margin="20,0,20,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Width="50" Height="50" RadiusX="6" RadiusY="6">
                        <Rectangle.Fill>
                            <ImageBrush x:Name="BottomSheetCover" Stretch="UniformToFill">
                                <ImageBrush.RelativeTransform>
                                    <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1"/>
                                </ImageBrush.RelativeTransform>
                            </ImageBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                        <TextBlock x:Name="BottomSheetTitle" Text="Title" FontSize="18" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="BottomSheetArtist" Text="Artist" FontSize="14" Foreground="#B3B3B3" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
                <Rectangle Height="1" Fill="#333333" Margin="0,0,0,5"/>
                <Button Click="Play_Click" Style="{StaticResource IconButtonStyle}" Height="55" HorizontalContentAlignment="Stretch">
                    <Grid Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Viewbox Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Left"><Path Data="M8,5.14V19.14L19,12.14L8,5.14Z" Fill="White"/></Viewbox>
                        <TextBlock Grid.Column="1" Text="Play" FontSize="17" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Click="AddToQueue_Click" Style="{StaticResource IconButtonStyle}" Height="55" HorizontalContentAlignment="Stretch">
                    <Grid Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Viewbox Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Left"><Path Data="M15,6H3V8H15V6M15,10H3V12H15V10M3,16H11V14H3V16M17,6V14.18C16.69,14.07 16.35,14 16,14A3,3 0 0,0 13,17A3,3 0 0,0 16,20A3,3 0 0,0 19,17V8H22V6H17Z" Fill="White"/></Viewbox>
                        <TextBlock Grid.Column="1" Text="Add to Queue" FontSize="17" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Click="GoToRadio_Click" Style="{StaticResource IconButtonStyle}" Height="55" HorizontalContentAlignment="Stretch">
                    <Grid Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Viewbox Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Left"><Path Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M9.5,16.5V7.5L16.5,12L9.5,16.5Z" Fill="White"/></Viewbox>
                        <TextBlock Grid.Column="1" Text="Go to Radio" FontSize="17" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Click="AddToPlaylist_Click" Style="{StaticResource IconButtonStyle}" Height="55" HorizontalContentAlignment="Stretch">
                    <Grid Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Viewbox Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Left"><Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="White"/></Viewbox>
                        <TextBlock Grid.Column="1" Text="Add to Playlist" FontSize="17" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Click="GoToArtist_Click" Style="{StaticResource IconButtonStyle}" Height="55" HorizontalContentAlignment="Stretch">
                    <Grid Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Viewbox Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Left"><Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" Fill="White"/></Viewbox>
                        <TextBlock Grid.Column="1" Text="Go to Artist" FontSize="17" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Click="SleepTimer_Click" Style="{StaticResource IconButtonStyle}" Height="55" HorizontalContentAlignment="Stretch">
                    <Grid Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Viewbox Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Left"><Path Data="M12,20A7,7 0 0,1 5,13A7,7 0 0,1 12,6A7,7 0 0,1 19,13A7,7 0 0,1 12,20M12,4A9,9 0 0,0 3,13A9,9 0 0,0 12,22A9,9 0 0,0 21,13A9,9 0 0,0 12,4M12.5,8H11V14L16.25,17.15L17,15.92L12.5,13.25V8M7.88,3.39L6.6,1.86L2,5.71L3.29,7.24L7.88,3.39M22,5.72L17.4,1.86L16.11,3.39L20.71,7.25L22,5.72Z" Fill="White"/></Viewbox>
                        <TextBlock Grid.Column="1" Text="Sleep Timer" FontSize="17" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Click="Share_Click" Style="{StaticResource IconButtonStyle}" Height="55" HorizontalContentAlignment="Stretch">
                    <Grid Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Viewbox Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Left"><Path Data="M18,16.08C17.24,16.08 16.56,16.38 16.04,16.85L8.91,12.7C8.96,12.47 9,12.24 9,12C9,11.76 8.96,11.53 8.91,11.3L15.96,7.19C16.5,7.69 17.21,8 18,8A3,3 0 0,0 21,5A3,3 0 0,0 18,2A3,3 0 0,0 15,5C15,5.24 15.04,5.47 15.09,5.7L8.04,9.81C7.5,9.31 6.79,9 6,9A3,3 0 0,0 3,12A3,3 0 0,0 6,15C6.79,15 7.5,14.69 8.04,14.19L15.16,18.34C15.11,18.55 15.08,18.77 15.08,19C15.08,20.61 16.39,21.91 18,21.91C19.61,21.91 20.92,20.61 20.92,19A2.92,2.92 0 0,0 18,16.08Z" Fill="White"/></Viewbox>
                        <TextBlock Grid.Column="1" Text="Share" FontSize="17" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button x:Name="BottomSheetDeleteBtn" Click="Delete_Click" Style="{StaticResource IconButtonStyle}" Height="55" HorizontalContentAlignment="Stretch" Visibility="Collapsed">
                    <Grid Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Viewbox Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Left"><Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Fill="#FF4444"/></Viewbox>
                        <TextBlock Grid.Column="1" Text="Delete from device" FontSize="17" Foreground="#FF4444" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Click="Close_Click" Style="{StaticResource IconButtonStyle}" Height="55" Margin="0,5,0,15">
                    <TextBlock Text="Close" FontSize="17" Foreground="#B3B3B3" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
