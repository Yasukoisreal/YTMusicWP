<UserControl
    x:Class="YTMusicWP.Controls.LibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Library tab. Named elements are x:FieldModifier="internal" because MainPage (Library/Auth partials)
         still drives them directly, e.g. LibraryPanel.LibraryUnifiedList. -->

    <UserControl.Resources>
        <!-- Same implicit fonts as MainPage (page-level implicit styles are not guaranteed to reach inside a UserControl) -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MontserratRegular}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource MontserratRegular}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource MontserratMedium}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Library Header -->
        <Grid Margin="15,15,15,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Width="32" Height="32" Margin="0,0,10,0">
                <Border x:Name="LibAvatarFallback" x:FieldModifier="internal" Width="32" Height="32" CornerRadius="16" Background="#1DB954">
                    <TextBlock x:Name="LibAvatarLetter" x:FieldModifier="internal" Text="Y" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Ellipse x:Name="LibAvatarImage" x:FieldModifier="internal" Width="32" Height="32" Visibility="Collapsed">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="LibAvatarBrush" x:FieldModifier="internal" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
            <TextBlock Grid.Column="1" Text="Library" FontSize="24" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            <Button x:Name="LibrarySyncBtn" x:FieldModifier="internal" Grid.Column="2" Click="LibrarySync_Click" Style="{StaticResource IconButtonStyle}" Width="40" Height="40">
                <TextBlock Text="&#xE117;" FontFamily="Segoe UI Symbol" FontSize="18" Foreground="White"/>
            </Button>
            <Button Grid.Column="3" Click="NavSearch_Click" Style="{StaticResource IconButtonStyle}" Width="40" Height="40">
                <Viewbox Width="20" Height="20"><Path Data="M9.5,2 C5.36,2 2,5.36 2,9.5 C2,13.64 5.36,17 9.5,17 C11.24,17 12.84,16.41 14.12,15.42 L19.35,20.65 L20.65,19.35 L15.42,14.12 C16.41,12.84 17,11.24 17,9.5 C17,5.36 13.64,2 9.5,2 Z M9.5,4.5 C12.26,4.5 14.5,6.74 14.5,9.5 C14.5,12.26 12.26,14.5 9.5,14.5 C6.74,14.5 4.5,12.26 4.5,9.5 C4.5,6.74 6.74,4.5 9.5,4.5 Z" Fill="White"/></Viewbox>
            </Button>
            <Button Grid.Column="4" Click="NavCreate_Click" Style="{StaticResource IconButtonStyle}" Width="40" Height="40">
                <Viewbox Width="20" Height="20"><Path Data="M11,2 L13,2 L13,11 L22,11 L22,13 L13,13 L13,22 L11,22 L11,13 L2,13 L2,11 L11,11 Z" Fill="White"/></Viewbox>
            </Button>
            <Button Grid.Column="5" Style="{StaticResource IconButtonStyle}" Width="40" Height="40">
                <TextBlock Text="⋮" FontSize="22" Foreground="White" FontWeight="Bold"/>
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Export Playlists (JSON)" Click="ExportPlaylists_Click"/>
                        <MenuFlyoutItem Text="Import Playlists (JSON)" Click="ImportPlaylists_Click"/>
                        <MenuFlyoutItem Text="💾 Export as M3U" Click="ExportAllPlaylistsM3u_Click"/>
                        <MenuFlyoutItem Text="📥 Import M3U Playlist" Click="ImportM3uPlaylist_Click"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Filter Chips -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" Margin="15,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="LibChipAll" x:FieldModifier="internal" Content="All" Click="LibChip_Click" Tag="all" Style="{StaticResource ChipButtonStyle}" Background="White" Foreground="#0F0F0F" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold" FontSize="13" Padding="14,6" Margin="0,0,8,0"/>
                <Button x:Name="LibChipPlaylists" x:FieldModifier="internal" Content="Playlists" Click="LibChip_Click" Tag="playlists" Style="{StaticResource ChipButtonStyle}" Background="#262626" Foreground="White" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold" FontSize="13" Padding="14,6" Margin="0,0,8,0"/>
                <Button x:Name="LibChipSongs" x:FieldModifier="internal" Content="Songs" Click="LibChip_Click" Tag="songs" Style="{StaticResource ChipButtonStyle}" Background="#262626" Foreground="White" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold" FontSize="13" Padding="14,6" Margin="0,0,8,0"/>
                <Button x:Name="LibChipArtists" x:FieldModifier="internal" Content="Artists" Click="LibChip_Click" Tag="artists" Style="{StaticResource ChipButtonStyle}" Background="#262626" Foreground="White" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold" FontSize="13" Padding="14,6" Margin="0,0,8,0"/>
                <Button x:Name="LibChipDownloads" x:FieldModifier="internal" Content="Downloads" Click="LibChip_Click" Tag="downloads" Style="{StaticResource ChipButtonStyle}" Background="#262626" Foreground="White" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold" FontSize="13" Padding="14,6" Margin="0,0,15,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Unified Library List -->
        <ListView x:Name="LibraryUnifiedList" x:FieldModifier="internal" Grid.Row="2" IsItemClickEnabled="True" ItemClick="LibraryUnified_ItemClick" SelectionMode="None" ItemContainerStyle="{StaticResource StretchItemStyle}" VirtualizingStackPanel.VirtualizationMode="Recycling" ShowsScrollingPlaceholders="False" Margin="15,0,15,0">
            <ListView.Header>
                <StackPanel Margin="0,4,0,8">
                    <!-- 4 Quick-access cards (SimpMusic style) -->
                    <Grid x:Name="LibQuickSection" x:FieldModifier="internal" Margin="0,4,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 1. Favorites -->
                        <Button x:Name="LibTileFavorite" x:FieldModifier="internal" Grid.Row="0" Grid.Column="0" Click="LibTileFavorite_Click" Style="{StaticResource CategoryButtonStyle}" Height="50">
                            <Border Background="#FF99AE" CornerRadius="8" Height="50" Padding="12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="20" Height="20" Margin="0,0,8,0">
                                        <Path Fill="#D10000" Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.28 2,8.5C2,5.42 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.09C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.42 22,8.5C22,12.28 18.6,15.36 13.45,20.04L12,21.35Z"/>
                                    </Viewbox>
                                    <TextBlock Text="Favorites" FontSize="14" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- 2. Followed -->
                        <Button x:Name="LibTileFollowed" x:FieldModifier="internal" Grid.Row="0" Grid.Column="2" Click="LibTileFollowed_Click" Style="{StaticResource CategoryButtonStyle}" Height="50">
                            <Border Background="#FFEB3B" CornerRadius="8" Height="50" Padding="12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="20" Height="20" Margin="0,0,8,0">
                                        <Path Fill="Black" Data="M5,9.2h3V19H5V9.2z M10.6,5h2.8v14h-2.8V5z M16.2,13H19v6h-2.8V13z"/>
                                    </Viewbox>
                                    <TextBlock Text="Followed" FontSize="14" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- 3. Most Played -->
                        <Button x:Name="LibTileMostPlayed" x:FieldModifier="internal" Grid.Row="2" Grid.Column="0" Click="LibTileMostPlayed_Click" Style="{StaticResource CategoryButtonStyle}" Height="50">
                            <Border Background="#00BCD4" CornerRadius="8" Height="50" Padding="12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="20" Height="20" Margin="0,0,8,0">
                                        <Path Fill="Black" Data="M16,6l2.29,2.29-4.88,4.88-4-4L2,16.59 3.41,18l6-6 4,4 6.3-6.29L22,12V6z"/>
                                    </Viewbox>
                                    <TextBlock Text="Most Played" FontSize="14" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- 4. Downloaded -->
                        <Button x:Name="LibTileDownloaded" x:FieldModifier="internal" Grid.Row="2" Grid.Column="2" Click="LibTileDownloaded_Click" Style="{StaticResource CategoryButtonStyle}" Height="50">
                            <Border Background="#4CAF50" CornerRadius="8" Height="50" Padding="12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="20" Height="20" Margin="0,0,8,0">
                                        <Path Fill="Black" Data="M19,9h-4V3H9v6H5l7,7 7-7z M5,18v2h14v-2H5z"/>
                                    </Viewbox>
                                    <TextBlock Text="Downloaded" FontSize="14" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- 5. Listening stats -->
                        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Click="LibTileStats_Click" Style="{StaticResource CategoryButtonStyle}" Height="50">
                            <Border Background="#B39DDB" CornerRadius="8" Height="50" Padding="12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="20" Height="20" Margin="0,0,8,0">
                                        <Path Fill="Black" Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20M12.5,7H11V13L16.2,16.2L17,14.9L12.5,12.2V7Z"/>
                                    </Viewbox>
                                    <TextBlock Text="Listening stats" FontSize="14" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </Grid>

                    <!-- Most Played Shelf -->
                    <StackPanel x:Name="LibMostPlayedSection" x:FieldModifier="internal" Visibility="Collapsed" Margin="0,0,0,16">
                        <TextBlock Text="Most Played" FontSize="18" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                        <ListView x:Name="LibMostPlayedCarousel" x:FieldModifier="internal" Height="175" IsItemClickEnabled="True" ItemClick="SongList_ItemClick" SelectionMode="None" ItemContainerStyle="{StaticResource HorizontalItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.IsHorizontalScrollChainingEnabled="False">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="110" Margin="0,0,12,0" Background="Transparent" Holding="SongItem_Holding">
                                        <FlyoutBase.AttachedFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="▶ Play" Click="MenuPlay_Click"/>
                                                <MenuFlyoutItem Text="♡ Favorite" Click="MenuFavorite_Click"/>
                                                <MenuFlyoutItem Text="🎵 Add to Playlist" Click="MenuAddToPlaylist_Click"/>
                                                <MenuFlyoutItem Text="⬇ Download" Click="MenuDownload_Click" Visibility="{Binding DownloadVisibility}"/>
                                            </MenuFlyout>
                                        </FlyoutBase.AttachedFlyout>
                                        <StackPanel>
                                            <Rectangle Width="110" Height="110" RadiusX="8" RadiusY="8" Margin="0,0,0,6">
                                                <Rectangle.Fill>
                                                    <ImageBrush Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center">
                                                        <ImageBrush.ImageSource>
                                                            <BitmapImage UriSource="{Binding ThumbnailUrl, Converter={StaticResource SquareThumbConverter}}" DecodePixelWidth="120"/>
                                                        </ImageBrush.ImageSource>
                                                    </ImageBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold" Foreground="White" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ChannelName}" FontSize="11" Foreground="#B3B3B3" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- Section Title & Sort Dropdown -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LibSectionTitle" x:FieldModifier="internal" Grid.Column="0" Text="Recently Added" FontSize="18" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Button x:Name="LibSortBtn" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Padding="6,2" MinHeight="0" MinWidth="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="LibSortLabel" x:FieldModifier="internal" Text="Recent activity" FontSize="13" FontFamily="{StaticResource MontserratSemiBold}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="▾" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="LibSortItemActivity" x:FieldModifier="internal" Text="✓ Recent activity" Click="LibSortOption_Click" Tag="activity"/>
                                    <MenuFlyoutItem x:Name="LibSortItemAdded" x:FieldModifier="internal" Text="  Recently added" Click="LibSortOption_Click" Tag="added"/>
                                    <MenuFlyoutItem x:Name="LibSortItemPlayed" x:FieldModifier="internal" Text="  Recently played" Click="LibSortOption_Click" Tag="played"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </StackPanel>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,5,0,5" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Thumbnail area -->
                        <Grid Width="56" Height="56" Margin="0,0,12,0">
                            <!-- Fallback: icon on dark background (always rendered behind) -->
                            <Border CornerRadius="6" Background="#282828">
                                <TextBlock Text="{Binding IconGlyph}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                            </Border>
                            <!-- Thumbnail image on top (covers icon when available) -->
                            <Border CornerRadius="6">
                                <Border.Background>
                                    <ImageBrush Stretch="UniformToFill">
                                        <ImageBrush.ImageSource>
                                            <BitmapImage UriSource="{Binding ThumbnailUrl, Converter={StaticResource SquareThumbConverter}}" DecodePixelWidth="100"/>
                                        </ImageBrush.ImageSource>
                                    </ImageBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <!-- Text -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="16" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="#B3B3B3" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty State -->
        <StackPanel x:Name="LibraryEmptyState" x:FieldModifier="internal" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="🎵" FontSize="48" HorizontalAlignment="Center"/>
            <TextBlock Text="No items yet" FontSize="18" FontFamily="{StaticResource MontserratSemiBold}" Foreground="#B3B3B3" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Hidden old ListViews (keep bindings working) -->
        <ListView x:Name="FavoriteSongList" x:FieldModifier="internal" Visibility="Collapsed"/>
        <ListView x:Name="HistorySongList" x:FieldModifier="internal" Visibility="Collapsed"/>
        <ListView x:Name="DownloadedSongList" x:FieldModifier="internal" Visibility="Collapsed"/>
        <ListView x:Name="PlaylistsListView" x:FieldModifier="internal" Visibility="Collapsed"/>
        <ListView x:Name="YouTubePlaylistsListView" x:FieldModifier="internal" Visibility="Collapsed"/>
        <ListView x:Name="SubscriptionsListView" x:FieldModifier="internal" Visibility="Collapsed"/>
    </Grid>
</UserControl>
