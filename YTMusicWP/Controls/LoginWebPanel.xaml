<UserControl
    x:Class="YTMusicWP.Controls.LoginWebPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Google sign-in screen (device code + WebView). Named elements are x:FieldModifier="internal" because MainPage still drives them directly. -->

    <UserControl.Resources>
        <!-- Same implicit TextBlock font as MainPage (page-level implicit styles are not guaranteed to reach inside a UserControl) -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MontserratRegular}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#282828" Padding="15">
            <Grid>
                <TextBlock Text="Sign in with Google" Foreground="White" FontSize="18" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="✕" Click="CloseLoginWeb_Click" Foreground="White" FontSize="20" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0" MinWidth="0"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,20,24,30">
                <!-- QR Code Card -->
                <Border x:Name="DeviceCodeQrContainer" x:FieldModifier="internal" Background="White" CornerRadius="16" Padding="12" Width="196" Height="196" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Grid>
                        <Image x:Name="DeviceCodeQrImage" x:FieldModifier="internal" Stretch="Uniform" Width="172" Height="172"/>
                        <ProgressRing x:Name="DeviceCodeQrLoading" x:FieldModifier="internal" IsActive="True" Foreground="#1DB954" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                
                <!-- Scan Instructions -->
                <TextBlock Text="Scan QR code with your phone camera to sign in instantly" Foreground="White" FontSize="14" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16"/>
                
                <!-- Divider with OR -->
                <Grid Margin="0,0,0,14">
                    <Rectangle Height="1" Fill="#333333" VerticalAlignment="Center"/>
                    <Border Background="#121212" Padding="12,0" HorizontalAlignment="Center">
                        <TextBlock Text="OR ENTER CODE MANUALLY" Foreground="#777777" FontSize="11" FontFamily="{StaticResource MontserratSemiBold}"/>
                    </Border>
                </Grid>
                
                <!-- URL and Code in compact card -->
                <Border Background="#1E1E1E" CornerRadius="12" Padding="16,12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="1. Go to google.com/device" Foreground="#B3B3B3" FontSize="13" TextAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="2. Enter this code:" Foreground="#B3B3B3" FontSize="13" TextAlignment="Center" Margin="0,0,0,8"/>
                        <Border Background="#282828" CornerRadius="8" Padding="12,8">
                            <TextBlock x:Name="DeviceCodeText" x:FieldModifier="internal" Text="----" Foreground="#1DB954" FontSize="22" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" TextAlignment="Center" CharacterSpacing="60" IsTextSelectionEnabled="True"/>
                        </Border>
                    </StackPanel>
                </Border>
                
                <!-- Status -->
                <ProgressBar x:Name="DeviceCodeProgress" x:FieldModifier="internal" IsIndeterminate="True" Foreground="#1DB954" Margin="0,0,0,8"/>
                <TextBlock x:Name="DeviceCodeStatus" x:FieldModifier="internal" Text="Waiting for you to sign in..." Foreground="#888888" FontSize="13" TextAlignment="Center" Margin="0,0,0,10"/>
            </StackPanel>
        </ScrollViewer>
        <!-- Hidden: old WebView (kept for code compatibility) -->
        <WebView x:Name="LoginWebView" x:FieldModifier="internal" Grid.Row="1" Visibility="Collapsed"/>
        <ProgressBar x:Name="LoginWebLoading" x:FieldModifier="internal" Grid.Row="1" VerticalAlignment="Top" IsIndeterminate="True" Foreground="#1DB954" Visibility="Collapsed"/>
    </Grid>
</UserControl>
