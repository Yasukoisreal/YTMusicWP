                                <ComboBoxItem Content="Denmark (DK)" Tag="DK"/>
                                <ComboBoxItem Content="Dominican Republic (DO)" Tag="DO"/>
                                <ComboBoxItem Content="Ecuador (EC)" Tag="EC"/>
                                <ComboBoxItem Content="Egypt (EG)" Tag="EG"/>
                                <ComboBoxItem Content="El Salvador (SV)" Tag="SV"/>
                                <ComboBoxItem Content="Estonia (EE)" Tag="EE"/>
                                <ComboBoxItem Content="Finland (FI)" Tag="FI"/>
                                <ComboBoxItem Content="France (FR)" Tag="FR"/>
                                <ComboBoxItem Content="Georgia (GE)" Tag="GE"/>
                                <ComboBoxItem Content="Germany (DE)" Tag="DE"/>
                                <ComboBoxItem Content="Ghana (GH)" Tag="GH"/>
                                <ComboBoxItem Content="Greece (GR)" Tag="GR"/>
                                <ComboBoxItem Content="Guatemala (GT)" Tag="GT"/>
                                <ComboBoxItem Content="Honduras (HN)" Tag="HN"/>
                                <ComboBoxItem Content="Hong Kong (HK)" Tag="HK"/>
