        <!-- ═══════════════════════════════════ MUSIC SHORTS VIEW ═══════════════════════════════════ -->
        <controls:ShortsPanel x:Name="ShortsView" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Canvas.ZIndex="55"
            ShortsBackClick="ShortsBack_Click" ShortsHeartClick="ShortsHeart_Click" ShortsPlayCurrentClick="ShortsPlayCurrent_Click" ShortsSongBarTapped="ShortsSongBar_Tapped" ShortsManipulationCompleted="Shorts_ManipulationCompleted" ShortsManipulationDelta="Shorts_ManipulationDelta"/>

        <!-- ═══════════════════════════════════ ARTIST PROFILE VIEW ═══════════════════════════════════ -->
        <Grid x:Name="ArtistProfileView" Grid.Row="0" Visibility="Collapsed" Canvas.ZIndex="45" Background="#121212">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ArtistTransform" Y="1000"/>
            </Grid.RenderTransform>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- ======= HERO HEADER ======= -->
                    <Grid Height="340">
                        <Image x:Name="ArtistProfileCover" Stretch="UniformToFill"/>
                        <!-- Dark gradient overlay bottom -->
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0.0"/>
                                    <GradientStop Color="#60121212" Offset="0.55"/>
                                    <GradientStop Color="#FF121212" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!-- Back button -->
                        <Button Click="CloseArtistProfile_Click" Style="{StaticResource IconButtonStyle}" Width="44" Height="44" Margin="8,25,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="Back">
                            <Viewbox Width="18" Height="18"><Path Data="M20,11V13H8L13.5,18.5 12.08,19.92 4.16,12 12.08,4.08 13.5,5.5 8,11H20Z" Fill="White"/></Viewbox>
                        </Button>
                        <!-- Artist name + listeners at bottom -->
                        <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,16">
                            <TextBlock x:Name="ArtistProfileTitle" Text="Artist" FontSize="32" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ArtistMonthlyListeners" Text="" FontSize="13" Foreground="#B3B3B3" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- ======= ACTION ROW ======= -->
                    <Grid Margin="16,8,16,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Follow button (outline) -->
                        <Button x:Name="ArtistFollowBtn" Grid.Column="0" Click="ArtistFollow_Click" Content="Follow" FontSize="13" FontFamily="{StaticResource MontserratSemiBold}" Foreground="White" VerticalAlignment="Center" MinHeight="36" MinWidth="80">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="4" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" Padding="16,8" Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Play button (green filled circle - same as Now Playing) -->
                        <Button Grid.Column="1" Click="ArtistPlayAll_Click" Style="{StaticResource IconButtonStyle}" Width="46" Height="46" Margin="16,0,0,0" AutomationProperties.Name="Play all">
                            <Border Width="46" Height="46" CornerRadius="23" Background="#1DB954">
                                <SymbolIcon Symbol="Play" Foreground="Black"/>
                            </Border>
                        </Button>
                        <!-- Shuffle button (same icon as Now Playing) -->
                        <Button Grid.Column="2" Click="ArtistShuffle_Click" Style="{StaticResource IconButtonStyle}" Width="44" Height="44" Margin="6,0,0,0" AutomationProperties.Name="Shuffle">
                            <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE14B;" Foreground="White" FontSize="20"/>
                        </Button>
                        <!-- Loading bar -->
                        <ProgressBar x:Name="ArtistLoadingBar" Grid.Column="3" IsIndeterminate="True" Visibility="Collapsed" Foreground="#1DB954" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>

                    <!-- ======= PHỔ BIẾN (Popular) ======= -->
                    <TextBlock Text="Popular" FontSize="18" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White" Margin="16,14,16,6"/>

                    <!-- Songs list -->
                    <ListView x:Name="ArtistSongsList" IsItemClickEnabled="True" ItemClick="SongList_ItemClick" SelectionMode="None" ItemTemplate="{StaticResource SongItemTemplate}" ItemContainerStyle="{StaticResource StretchItemStyle}" VirtualizingStackPanel.VirtualizationMode="Recycling" Margin="6,0,6,0"/>

                    <!-- ======= SECTIONS (Albums, Singles, Videos, etc.) ======= -->
                    <ItemsControl x:Name="ArtistSectionsControl" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="{Binding Title}" FontSize="18" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White" Margin="16,0,16,8"/>
                                    <ListView ItemsSource="{Binding Items}" Height="172" VirtualizingStackPanel.VirtualizationMode="Recycling" IsItemClickEnabled="True" ItemClick="ArtistAlbum_ItemClick" SelectionMode="None" ItemTemplate="{StaticResource ArtistAlbumItemTemplate}" ItemContainerStyle="{StaticResource HorizontalItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollMode="Disabled" Margin="16,0,0,0">
                                        <ListView.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
                                    </ListView>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ======= GIỚI THIỆU (About) ======= -->
                    <StackPanel x:Name="ArtistAboutSection" Visibility="Collapsed" Margin="16,16,16,8">
                        <TextBlock Text="About" FontSize="18" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                        <Border CornerRadius="12" MinHeight="200" Background="#1A1A1A" Tapped="ArtistAbout_Tapped">
                            <Grid>
                                <Border CornerRadius="12">
                                    <Border.Background>
                                        <ImageBrush x:Name="ArtistAboutImage" Stretch="UniformToFill" Opacity="0.5"/>
                                    </Border.Background>
                                </Border>
                                <Rectangle RadiusX="12" RadiusY="12">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.2"/>
                                            <GradientStop Color="#DD000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <StackPanel VerticalAlignment="Bottom" Margin="16,16,16,16">
                                    <TextBlock x:Name="ArtistAboutListeners" FontSize="16" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="followers" FontSize="12" Foreground="#B3B3B3" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="ArtistAboutDescription" FontSize="12" Foreground="#CCCCCC" Margin="0,8,0,0" MaxLines="3" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Bottom padding for mini player -->
                    <Rectangle Height="20"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══════════════════════════════════ MINI PLAYER (Row 1) ═══════════════════════════════════ -->
        <Grid Grid.Row="1">
            <!-- Mini player green accent top line -->
            <Rectangle Height="2" VerticalAlignment="Top" Canvas.ZIndex="5">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#1DB954" Offset="0"/>
                        <GradientStop Color="#1DB954" Offset="0.5"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Border Background="#181818" Padding="10,8,10,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="MiniPlayerInfoGrid" Grid.Column="0" Background="Transparent"
                          Tapped="MiniPlayer_Tapped"
                          ManipulationMode="TranslateX,System"
                          ManipulationDelta="MiniPlayer_ManipulationDelta"
                          ManipulationCompleted="MiniPlayer_ManipulationCompleted">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="MiniPlayerTranslate" X="0"/>
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle x:Name="MiniCoverRectangle" Grid.Column="0" Width="46" Height="46" RadiusX="8" RadiusY="8" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Rectangle.Fill>
                                <ImageBrush x:Name="MiniCoverImage" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
                            </Rectangle.Fill>
                        </Rectangle>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock x:Name="MiniTitle" Text="Not playing" FontSize="15" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="MiniArtist" Text="Select a song" FontSize="13" Foreground="#B3B3B3" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                    <Button x:Name="MiniPlayPauseBtn" Grid.Column="1" Click="PlayPauseButton_Click" Style="{StaticResource IconButtonStyle}" Width="50" AutomationProperties.Name="Play or pause">
                        <SymbolIcon x:Name="MiniPlayIcon" Symbol="Play" Foreground="White"/>
                    </Button>
                    <Button Grid.Column="2" Click="NextButton_Click" Style="{StaticResource IconButtonStyle}" Width="50" AutomationProperties.Name="Next track">
                        <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE101;" Foreground="White" FontSize="20"/>
                    </Button>
                </Grid>
            </Border>
            <ProgressBar x:Name="MiniProgressBar" VerticalAlignment="Bottom" Height="2" Minimum="0" Maximum="100" Value="0" Foreground="#1DB954" Background="#333333" BorderThickness="0" IsHitTestVisible="False"/>
        </Grid>

        <!-- ═══════════════════════════════════ BOTTOM NAV (Row 2) ═══════════════════════════════════ -->
        <Border Grid.Row="2" Background="#0D0D0D" BorderBrush="#1F1F1F" BorderThickness="0,1,0,0" Padding="0,8,0,10" Canvas.ZIndex="96">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Home -->
                <Button Grid.Column="0" Click="NavHome_Click" Style="{StaticResource IconButtonStyle}" MinHeight="0">
                    <StackPanel HorizontalAlignment="Center">
                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center">
                            <Path x:Name="NavHomeIcon" Fill="White" Stretch="Uniform" Data="M12,2 L3,10 L3,22 L9,22 L9,16 L15,16 L15,22 L21,22 L21,10 Z"/>
                        </Viewbox>
                        <TextBlock x:Name="NavHomeText" Text="Home" FontSize="10" Foreground="White" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
                <!-- Search -->
                <Button Grid.Column="1" Click="NavSearch_Click" Style="{StaticResource IconButtonStyle}" MinHeight="0">
                    <StackPanel HorizontalAlignment="Center">
                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center">
                            <Path x:Name="NavSearchIcon" Fill="#B3B3B3" Stretch="Uniform" Data="M9.5,2 C5.36,2 2,5.36 2,9.5 C2,13.64 5.36,17 9.5,17 C11.24,17 12.84,16.41 14.12,15.42 L19.35,20.65 L20.65,19.35 L15.42,14.12 C16.41,12.84 17,11.24 17,9.5 C17,5.36 13.64,2 9.5,2 Z M9.5,4.5 C12.26,4.5 14.5,6.74 14.5,9.5 C14.5,12.26 12.26,14.5 9.5,14.5 C6.74,14.5 4.5,12.26 4.5,9.5 C4.5,6.74 6.74,4.5 9.5,4.5 Z"/>
                        </Viewbox>
                        <TextBlock x:Name="NavSearchText" Text="Search" FontSize="10" Foreground="#B3B3B3" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
                <!-- Library -->
                <Button Grid.Column="2" Click="NavLibrary_Click" Style="{StaticResource IconButtonStyle}" MinHeight="0">
                    <StackPanel HorizontalAlignment="Center">
                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center">
                            <Path x:Name="NavLibraryIcon" Fill="#B3B3B3" Stretch="Uniform" Data="M3,21 L3,3 L6,3 L6,21 Z M10,21 L10,3 L13,3 L13,21 Z M17,21 L17,7 L20,7 L20,21 Z"/>
                        </Viewbox>
                        <TextBlock x:Name="NavLibraryText" Text="Library" FontSize="10" Foreground="#B3B3B3" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
                <!-- Create -->
                <Button Grid.Column="3" Click="NavCreate_Click" Style="{StaticResource IconButtonStyle}" MinHeight="0">
                    <StackPanel HorizontalAlignment="Center">
                        <Grid HorizontalAlignment="Center" Width="22" Height="22">
                            <Ellipse x:Name="NavCreateCircle" Width="28" Height="28" Margin="-3" Fill="White" Visibility="Collapsed"/>
                            <Viewbox x:Name="NavCreateViewbox" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Viewbox.RenderTransform>
                                    <RotateTransform x:Name="NavCreateRotate" Angle="0"/>
                                </Viewbox.RenderTransform>
                                <Path x:Name="NavCreateIcon" Fill="#B3B3B3" Stretch="Uniform" Data="M11,2 L13,2 L13,11 L22,11 L22,13 L13,13 L13,22 L11,22 L11,13 L2,13 L2,11 L11,11 Z"/>
                            </Viewbox>
                        </Grid>
                        <TextBlock x:Name="NavCreateText" Text="Create" FontSize="10" Foreground="#B3B3B3" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
