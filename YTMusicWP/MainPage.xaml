            </Grid>
        </Border>

        <!-- ═══════════════════════════════════ CREATE FLOATING MENU ═══════════════════════════════════ -->
        <controls:CreateSheet x:Name="CreateBottomSheet" Visibility="Collapsed" Canvas.ZIndex="90" Grid.RowSpan="3" Tapped="CloseCreateSheet_Tapped"
            PlaylistClick="CreateSheet_Playlist_Click" CollabClick="CreateSheet_Collab_Click" BlendClick="CreateSheet_Blend_Click" ListenTogetherClick="OpenListenTogether_Click"/>

        <!-- ═══════════════════════════════════ NOW PLAYING VIEW ═══════════════════════════════════ -->
        <Grid x:Name="NowPlayingView" Background="#FF000000" Visibility="Collapsed" Canvas.ZIndex="100" Grid.RowSpan="3">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="NowPlayingTransform" Y="1000"/>
            </Grid.RenderTransform>
            <!-- Solid black base to ensure Home screen never bleeds through -->
            <Rectangle Fill="#FF000000" />
            <!-- Gradient background (genre-based color) -->
            <Rectangle x:Name="DefaultNowPlayingBackground">
                <Rectangle.Fill>
                    <LinearGradientBrush x:Name="NowPlayingGradient" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop x:Name="NowPlayingGradientTop" Color="#1A1A2E" Offset="0"/>
                        <GradientStop x:Name="NowPlayingGradientMid" Color="#121212" Offset="0.55"/>
                        <GradientStop Color="#0D0D0D" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- Apple Music: frosted artwork backdrop (Collapsed by default, shown by code) -->
            <Image x:Name="AppleMusicBackdrop" Stretch="UniformToFill" Visibility="Collapsed"/>
            <!-- Apple Music: tinted gradient wash over the blur -->
            <Rectangle x:Name="AppleMusicWash" Opacity="0.55" Visibility="Collapsed">
                <Rectangle.Fill>
                    <LinearGradientBrush x:Name="AppleMusicWashGradient" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop x:Name="AppleMusicGradTop" Color="#1A1A2E" Offset="0"/>
                        <GradientStop x:Name="AppleMusicGradMid" Color="#121212" Offset="0.48"/>
                        <GradientStop x:Name="AppleMusicGradBot" Color="#0D0D0D" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Grid Canvas.ZIndex="10" SizeChanged="NowPlayingContentGrid_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Apple Music: full-bleed artwork with gentle bottom fade -->
                <Grid x:Name="AppleMusicArtworkGrid" Grid.Row="0" Grid.RowSpan="2" Canvas.ZIndex="15" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="480" ManipulationMode="TranslateX" ManipulationStarted="AppleMusicArtworkGrid_ManipulationStarted" ManipulationCompleted="AppleMusicArtworkGrid_ManipulationCompleted">
                    <Image x:Name="AppleMusicArtwork" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="480"/>
                    <!-- Apple Music: top status bar scrim for icon readability over bright artwork -->
                    <Rectangle VerticalAlignment="Top" Height="38" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#38000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle x:Name="AppleMusicArtworkFade" VerticalAlignment="Bottom" Height="140" Visibility="Collapsed" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop x:Name="AppleMusicArtFadeTop" Color="#00000000" Offset="0"/>
                                <GradientStop x:Name="AppleMusicArtFadeMid" Color="#80000000" Offset="0.5"/>
                                <GradientStop x:Name="AppleMusicArtFadeBot" Color="#FF121212" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- Apple Music: grabber bar (floating at top in AM mode) -->
                <Border x:Name="AppleMusicGrabber" Visibility="Collapsed" Grid.Row="0" Canvas.ZIndex="30" Background="Transparent" Tapped="CloseNowPlaying_Click" Height="44" VerticalAlignment="Top" Margin="0,22,0,0" AutomationProperties.Name="Close now playing">
                    <Border Background="#59FFFFFF" CornerRadius="3" Width="36" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Grid x:Name="DefaultNowPlayingHeader" Grid.Row="0" Margin="0,20,0,0" Height="70">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Click="CloseNowPlaying_Click" Style="{StaticResource IconButtonStyle}" Background="#01000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="Close now playing">
                        <Viewbox Width="22" Height="22"><Path Data="M7.41,8.58L12,13.17 16.59,8.58 18,10 12,16 6,10Z" Fill="White"/></Viewbox>
                    </Button>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="NOW PLAYING" FontSize="11" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold" Foreground="#AAFFFFFF" CharacterSpacing="150" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Border Background="Transparent" Padding="8,6" Tapped="DotPlayer_Tapped">
                                <Ellipse x:Name="DotPlayer" Width="7" Height="7" Fill="#1DB954" Opacity="1.0"/>
                            </Border>
                            <Border Background="Transparent" Padding="8,6" Tapped="DotLyrics_Tapped">
                                <Ellipse x:Name="DotLyrics" Width="7" Height="7" Fill="White" Opacity="0.3"/>
                            </Border>
                            <Border Background="Transparent" Padding="8,6" Tapped="DotQueue_Tapped">
                                <Ellipse x:Name="DotQueue" Width="7" Height="7" Fill="White" Opacity="0.3"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
