        <!-- ═══════════════════════════════════ LIBRARY PANEL ═══════════════════════════════════ -->
        <Grid x:Name="LibraryPanel" Grid.Row="0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Library Header -->
            <Grid Margin="15,15,15,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="32" Height="32" Margin="0,0,10,0">
                    <Border x:Name="LibAvatarFallback" Width="32" Height="32" CornerRadius="16" Background="#1DB954">
                        <TextBlock x:Name="LibAvatarLetter" Text="Y" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Ellipse x:Name="LibAvatarImage" Width="32" Height="32" Visibility="Collapsed">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="LibAvatarBrush" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
                <TextBlock Grid.Column="1" Text="Your Library" FontSize="24" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <Button x:Name="LibrarySyncBtn" Grid.Column="2" Click="LibrarySync_Click" Style="{StaticResource IconButtonStyle}" Width="40" Height="40">
                    <TextBlock Text="&#xE117;" FontFamily="Segoe UI Symbol" FontSize="18" Foreground="White"/>
                </Button>
                <Button Grid.Column="3" Click="NavSearch_Click" Style="{StaticResource IconButtonStyle}" Width="40" Height="40">
                    <Viewbox Width="20" Height="20"><Path Data="M9.5,2 C5.36,2 2,5.36 2,9.5 C2,13.64 5.36,17 9.5,17 C11.24,17 12.84,16.41 14.12,15.42 L19.35,20.65 L20.65,19.35 L15.42,14.12 C16.41,12.84 17,11.24 17,9.5 C17,5.36 13.64,2 9.5,2 Z M9.5,4.5 C12.26,4.5 14.5,6.74 14.5,9.5 C14.5,12.26 12.26,14.5 9.5,14.5 C6.74,14.5 4.5,12.26 4.5,9.5 C4.5,6.74 6.74,4.5 9.5,4.5 Z" Fill="White"/></Viewbox>
                </Button>
                <Button Grid.Column="4" Click="NavCreate_Click" Style="{StaticResource IconButtonStyle}" Width="40" Height="40">
                    <Viewbox Width="20" Height="20"><Path Data="M11,2 L13,2 L13,11 L22,11 L22,13 L13,13 L13,22 L11,22 L11,13 L2,13 L2,11 L11,11 Z" Fill="White"/></Viewbox>
                </Button>
                <Button Grid.Column="5" Style="{StaticResource IconButtonStyle}" Width="40" Height="40">
                    <TextBlock Text="⋮" FontSize="22" Foreground="White" FontWeight="Bold"/>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Export Playlists (JSON)" Click="ExportPlaylists_Click"/>
                            <MenuFlyoutItem Text="Import Playlists (JSON)" Click="ImportPlaylists_Click"/>
                            <MenuFlyoutItem Text="💾 Export as M3U" Click="ExportAllPlaylistsM3u_Click"/>
                            <MenuFlyoutItem Text="📥 Import M3U Playlist" Click="ImportM3uPlaylist_Click"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!-- Filter Chips -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" Margin="15,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="LibChipAll" Content="All" Click="LibChip_Click" Tag="all" Style="{StaticResource ChipButtonStyle}" Background="#1DB954" Foreground="Black" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" FontSize="13" Padding="16,8" Margin="0,0,8,0"/>
                    <Button x:Name="LibChipPlaylists" Content="Playlists" Click="LibChip_Click" Tag="playlists" Style="{StaticResource ChipButtonStyle}" Background="#333333" Foreground="White" FontFamily="{StaticResource MontserratSemiBold}" FontSize="13" Padding="16,8" Margin="0,0,8,0"/>
                    <Button x:Name="LibChipArtists" Content="Artists" Click="LibChip_Click" Tag="artists" Style="{StaticResource ChipButtonStyle}" Background="#333333" Foreground="White" FontFamily="{StaticResource MontserratSemiBold}" FontSize="13" Padding="16,8" Margin="0,0,8,0"/>
                    <Button x:Name="LibChipDownloads" Content="Downloads" Click="LibChip_Click" Tag="downloads" Style="{StaticResource ChipButtonStyle}" Background="#333333" Foreground="White" FontFamily="{StaticResource MontserratSemiBold}" FontSize="13" Padding="16,8" Margin="0,0,8,0"/>
                    <Button x:Name="LibChipRecent" Content="Recent" Click="LibChip_Click" Tag="recent" Style="{StaticResource ChipButtonStyle}" Background="#333333" Foreground="White" FontFamily="{StaticResource MontserratSemiBold}" FontSize="13" Padding="16,8" Margin="0,0,15,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Sort Row -->
            <Grid Grid.Row="2" Margin="15,0,15,6">
                <TextBlock Text="Recents" FontSize="13" Foreground="#B3B3B3" FontFamily="{StaticResource MontserratSemiBold}" VerticalAlignment="Center"/>
            </Grid>

            <!-- Unified Library List -->
            <ListView x:Name="LibraryUnifiedList" Grid.Row="3" IsItemClickEnabled="True" ItemClick="LibraryUnified_ItemClick" SelectionMode="None" ItemContainerStyle="{StaticResource StretchItemStyle}" Margin="15,0,15,0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5,0,5" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Thumbnail area -->
                            <Grid Width="56" Height="56" Margin="0,0,12,0">
                                <!-- Fallback: icon on dark background (always rendered behind) -->
                                <Border CornerRadius="6" Background="#282828">
                                    <TextBlock Text="{Binding IconGlyph}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                </Border>
                                <!-- Thumbnail image on top (covers icon when available) -->
                                <Border CornerRadius="6">
                                    <Border.Background>
                                        <ImageBrush Stretch="UniformToFill">
                                            <ImageBrush.ImageSource>
                                                <BitmapImage UriSource="{Binding ThumbnailUrl, Converter={StaticResource SquareThumbConverter}}" DecodePixelWidth="100"/>
                                            </ImageBrush.ImageSource>
                                        </ImageBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <!-- Text -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="16" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="#B3B3B3" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty State -->
            <StackPanel x:Name="LibraryEmptyState" Grid.Row="3" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🎵" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="No items yet" FontSize="18" FontFamily="{StaticResource MontserratSemiBold}" Foreground="#B3B3B3" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Hidden old ListViews (keep bindings working) -->
            <ListView x:Name="FavoriteSongList" Visibility="Collapsed"/>
            <ListView x:Name="HistorySongList" Visibility="Collapsed"/>
            <ListView x:Name="DownloadedSongList" Visibility="Collapsed"/>
            <ListView x:Name="PlaylistsListView" Visibility="Collapsed"/>
            <ListView x:Name="YouTubePlaylistsListView" Visibility="Collapsed"/>
            <ListView x:Name="SubscriptionsListView" Visibility="Collapsed"/>
        </Grid>

        <!-- ═══════════════════════════════════ SETTINGS PANEL (overlay) ═══════════════════════════════════ -->
        <Grid x:Name="SettingsPanel" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Canvas.ZIndex="50">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1A1A2E" Offset="0"/>
                    <GradientStop Color="#0D0D0D" Offset="0.4"/>
                    <GradientStop Color="#121212" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="20,15,15,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Settings" FontSize="26" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Customize your experience" FontSize="12" Foreground="#666" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Click="CloseSettings_Click" Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right" Width="40" Height="40" VerticalAlignment="Top">
                    <Border Background="#1A1A1A" CornerRadius="20" Width="36" Height="36">
                        <Viewbox Width="14" Height="14"><Path Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12Z" Fill="#999"/></Viewbox>
                    </Border>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,15,0,0">
                <StackPanel Margin="16,0,16,50">

                    <!-- ═══════ ACCOUNT SECTION ═══════ -->
                    <Border Background="#1A1A1A" CornerRadius="16" Margin="0,0,0,16" Padding="18,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Background="#1DB954" CornerRadius="12" Width="28" Height="28" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE13D;" FontFamily="Segoe UI Symbol" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Account" FontSize="16" FontFamily="{StaticResource MontserratSemiBold}" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Hidden: OAuth credentials (auto-filled by app) -->
                            <Border Background="#1E1E1E" CornerRadius="10" Margin="0,0,0,10" Visibility="Collapsed">
                                <TextBox x:Name="ClientIdTextBox" PlaceholderText="Client ID..." Style="{StaticResource DarkTextBoxStyle}"/>
                            </Border>
                            <Border Background="#1E1E1E" CornerRadius="10" Margin="0,0,0,10" Visibility="Collapsed">
                                <TextBox x:Name="ClientSecretTextBox" PlaceholderText="Client Secret..." Style="{StaticResource DarkTextBoxStyle}"/>
                            </Border>

                            <!-- NOT LOGGED IN state -->
                            <StackPanel x:Name="AccountSignedOutPanel">
                                <TextBlock Text="Sign in to sync liked songs, playlists, and subscriptions." Foreground="#777" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap"/>
                                <Button Click="LoginCookie_Click" Style="{StaticResource CategoryButtonStyle}" Height="46" Margin="0,0,0,8">
                                    <Border CornerRadius="12">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#1DB954" Offset="0"/>
                                                <GradientStop Color="#1ED760" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE13D;" FontFamily="Segoe UI Symbol" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Sign in with Google" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                                <Button Click="LoginGoogle_Click" Style="{StaticResource CategoryButtonStyle}" Height="40">
                                    <Border CornerRadius="12" Background="#333">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE15B;" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="#999" Margin="0,0,8,0" VerticalAlignment="Center"/>
