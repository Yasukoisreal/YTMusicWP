                                                <TextBlock.RenderTransform><TranslateTransform X="-1.5" Y="-1.5"/></TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" FontStyle="{Binding FontStyle}" Foreground="{Binding ColorBrush}" Opacity="{Binding FarBlurOpacity}" TextWrapping="Wrap" TextAlignment="Left" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Left" IsHitTestVisible="False">
                                                <TextBlock.RenderTransform><TranslateTransform X="1.5" Y="-1.5"/></TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" FontStyle="{Binding FontStyle}" Foreground="{Binding ColorBrush}" Opacity="{Binding FarBlurOpacity}" TextWrapping="Wrap" TextAlignment="Left" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Left" IsHitTestVisible="False">
                                                <TextBlock.RenderTransform><TranslateTransform X="-1.5" Y="1.5"/></TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" FontStyle="{Binding FontStyle}" Foreground="{Binding ColorBrush}" Opacity="{Binding FarBlurOpacity}" TextWrapping="Wrap" TextAlignment="Left" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Left" IsHitTestVisible="False">
