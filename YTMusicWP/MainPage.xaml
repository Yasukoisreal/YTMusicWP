                </StackPanel>
                <!-- Lyrics content -->
                <ListView x:Name="FullscreenLyricsListView" Grid.Row="1" IsItemClickEnabled="True" ItemClick="LyricsListView_ItemClick" SelectionMode="None" ShowsScrollingPlaceholders="False" ContainerContentChanging="FullscreenLyricsListView_ContainerContentChanging" VirtualizingStackPanel.VirtualizationMode="Recycling">
