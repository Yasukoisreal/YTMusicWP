                        <Button Content="Create" Click="ConfirmCreatePlaylist_Click" Foreground="#1DB954" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>


        <!-- ═══════════════════════════════════ TOAST ═══════════════════════════════════ -->
        <Border x:Name="ToastNotification" Canvas.ZIndex="400" IsHitTestVisible="False" Visibility="Collapsed" Background="#1DB954" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Padding="14,10" Margin="15,0,15,130" CornerRadius="12" Grid.RowSpan="3">
            <TextBlock x:Name="ToastText" Text="Message" Foreground="White" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold" FontSize="14" TextAlignment="Center"/>
        </Border>

        <!-- ═══════════════════════════════════ DOWNLOAD STATUS ═══════════════════════════════════ -->
        <Border x:Name="DownloadStatusBar" Canvas.ZIndex="200" Visibility="Collapsed" Background="#1DB954" VerticalAlignment="Top" HorizontalAlignment="Stretch" Padding="15,10" Margin="0,0,0,0" Grid.RowSpan="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="DownloadStatusText" Text="Downloading..." Foreground="White" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="DownloadProgressBar" Grid.Row="1" Minimum="0" Maximum="100" Value="0" Foreground="White" Background="#116D31"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════ ANIMATED STARTUP SPLASH OVERLAY ═══════════════════════════════════ -->
        <Grid x:Name="SplashOverlay" Background="#212121" Canvas.ZIndex="999"
              Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Tapped="SplashOverlay_Tapped">
            <!-- Stretch=Uniform + Margin 40 + MaxWidth: co toàn bộ animation (kể cả pha đường đỏ full-width)
                 vừa trong màn hẹp nhất (WVGA ~480epx) với lề 2 bên, tránh cắt nút play/2 đầu line -->
            <Image x:Name="SplashAnimatedImage"
                   Stretch="Uniform"
                   HorizontalAlignment="Stretch" VerticalAlignment="Center"
                   MaxWidth="460" Margin="10,0"
                   gif:AnimationBehavior.SourceUri="ms-appx:///Assets/Hero_logo_animation_001.gif"
                   gif:AnimationBehavior.RepeatBehavior="1x"
                   gif:AnimationBehavior.AutoStart="True" />
        </Grid>
    </Grid>
</Page>

