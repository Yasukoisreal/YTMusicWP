                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#1DB954" CornerRadius="16" Width="32" Height="32" Margin="0,0,12,0">
                                            <TextBlock Text="✓" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="AccountUserName" Text="Signed In" FontSize="14" FontFamily="{StaticResource MontserratSemiBold}" Foreground="White"/>
                                            <TextBlock x:Name="LoginStatusText" Text="Synced" Foreground="#1DB954" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

