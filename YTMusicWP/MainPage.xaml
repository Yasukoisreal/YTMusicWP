                <!-- Quick Filter Bar -->
                <Grid x:Name="PlaylistFilterContainer" Margin="0,15,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PlaylistFilterBox" PlaceholderText="Find in playlist..." 
                             TextChanged="PlaylistFilterBox_TextChanged"
                             Background="#242424" Foreground="White" BorderThickness="0"
