                        <TextBlock Text="Artists" Foreground="White" FontSize="13" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#262626" CornerRadius="8" Padding="14,6" Margin="0,0,8,0" Tapped="SearchChip_Tapped" Tag="EgWKAQIIAWoQEAUQAxAEEAkQChAQEBUQEQ%3D%3D">
