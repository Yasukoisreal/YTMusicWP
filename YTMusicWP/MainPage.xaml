                    <!-- ═══════ PLAYBACK ═══════ -->
                    <Border Background="#1A1A1A" CornerRadius="16" Margin="0,0,0,16" Padding="18,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Background="#A855F7" CornerRadius="12" Width="28" Height="28" Margin="0,0,10,0">
                                    <TextBlock Text="♫" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Playback" FontSize="16" FontFamily="{StaticResource MontserratSemiBold}" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>





                            <!-- Autoplay -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Autoplay" Foreground="White" FontSize="15" FontFamily="{StaticResource MontserratSemiBold}"/>
                                    <TextBlock Text="Play similar songs when queue ends" Foreground="#555" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoplayToggle" Grid.Column="1" IsOn="True" OnContent="" OffContent="" VerticalAlignment="Center"/>
                            </Grid>
                            <Rectangle Height="1" Fill="#252525" Margin="0,8,0,8"/>

                            <!-- Gapless Playback -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Gapless Playback" Foreground="White" FontSize="15" FontFamily="{StaticResource MontserratSemiBold}"/>
                                    <TextBlock Text="No silence between tracks" Foreground="#555" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="GaplessToggle" Grid.Column="1" IsOn="True" OnContent="" OffContent="" VerticalAlignment="Center"/>
                            </Grid>
                            <Rectangle Height="1" Fill="#252525" Margin="0,8,0,8"/>

                            <!-- Normalize Volume -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Normalize Volume" Foreground="White" FontSize="15" FontFamily="{StaticResource MontserratSemiBold}"/>
                                    <TextBlock Text="Set the same volume for all songs" Foreground="#555" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="NormalizeVolumeToggle" Grid.Column="1" IsOn="False" OnContent="" OffContent="" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>


                    <!-- ═══════ APPEARANCE ═══════ -->
                    <Border Background="#1A1A1A" CornerRadius="16" Margin="0,0,0,16" Padding="18,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Background="#EC4899" CornerRadius="12" Width="28" Height="28" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE2B1;" FontFamily="Segoe UI Symbol" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Appearance" FontSize="16" FontFamily="{StaticResource MontserratSemiBold}" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Now Playing Style" Foreground="White" FontSize="15" FontFamily="{StaticResource MontserratSemiBold}"/>
                                    <TextBlock Text="Visual style for the player screen" Foreground="#555" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="NowPlayingStyleComboBox" Grid.Column="1" Background="#252525" Foreground="White" BorderThickness="0" Width="160" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Default (Gradient)" Tag="0" IsSelected="True"/>
                                    <ComboBoxItem Content="Apple Music (Blur)" Tag="1"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>


                    <!-- ═══════ LIVE TILE (START SCREEN) ═══════ -->
                    <Border Background="#1A1A1A" CornerRadius="16" Margin="0,0,0,16" Padding="18,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Background="#0078D7" CornerRadius="12" Width="28" Height="28" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE17C;" FontFamily="Segoe UI Symbol" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Live Tile (Start Screen)" FontSize="16" FontFamily="{StaticResource MontserratSemiBold}" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Enable Live Tile Toggle -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Dynamic Live Tile" Foreground="White" FontSize="15" FontFamily="{StaticResource MontserratSemiBold}"/>
                                    <TextBlock Text="Flip &amp; cycle music artwork on Start screen" Foreground="#555" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="LiveTileToggle" Grid.Column="1" IsOn="True" OnContent="" OffContent="" VerticalAlignment="Center"/>
                            </Grid>
                            <Rectangle Height="1" Fill="#252525" Margin="0,8,0,8"/>

                            <!-- Live Tile Mode Selector -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Display Mode" Foreground="White" FontSize="15" FontFamily="{StaticResource MontserratSemiBold}"/>
                                    <TextBlock Text="Choose what appears on Live Tile" Foreground="#555" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="LiveTileModeComboBox" Grid.Column="1" Background="#252525" Foreground="White" BorderThickness="0" Width="140" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Now Playing &amp; Recs" Tag="0"/>
                                    <ComboBoxItem Content="Now Playing Only" Tag="1"/>
                                    <ComboBoxItem Content="Transparent Only" Tag="2"/>
                                </ComboBox>
                            </Grid>
                            <Rectangle Height="1" Fill="#252525" Margin="0,8,0,8"/>

                            <!-- Live Tile Rotation Speed / Flip Frequency -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Cycle Speed" Foreground="White" FontSize="15" FontFamily="{StaticResource MontserratSemiBold}"/>
                                    <TextBlock Text="Pace of Live Tile rotation &amp; flips" Foreground="#555" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="LiveTileSpeedComboBox" Grid.Column="1" Background="#252525" Foreground="White" BorderThickness="0" Width="140" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Calm (Slow)" Tag="0"/>
                                    <ComboBoxItem Content="Moderate" Tag="1"/>
                                    <ComboBoxItem Content="Dynamic" Tag="2"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>


                    <!-- ═══════ STORAGE & CACHE MANAGEMENT ═══════ -->
                    <Border Background="#1A1A1A" CornerRadius="16" Margin="0,0,0,16" Padding="18,16">
                        <StackPanel>
                            <!-- Header with Refresh Button -->
                            <Grid Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#3B82F6" CornerRadius="12" Width="28" Height="28" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE14E;" FontFamily="Segoe UI Symbol" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Storage &amp; Cache" FontSize="16" FontFamily="{StaticResource MontserratSemiBold}" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Click="RefreshStorageStats_Click" HorizontalAlignment="Right" Padding="6" Background="Transparent" BorderThickness="0">
                                    <TextBlock Text="&#xE117;" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="#888"/>
                                </Button>
                            </Grid>

                            <!-- Total Storage Banner Card -->
                            <Border Background="#252525" CornerRadius="12" Padding="14,12" Margin="0,0,0,14">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="TOTAL APP STORAGE" FontSize="10" FontFamily="{StaticResource MontserratBold}" Foreground="#888"/>
                                        <TextBlock x:Name="StorageTotalText" Text="Calculating..." FontSize="20" FontFamily="{StaticResource MontserratBold}" Foreground="#1DB954" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ProgressRing x:Name="StorageLoadingRing" IsActive="True" Width="22" Height="22" Foreground="#1DB954" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Breakdown Items Grid -->
                            <StackPanel Margin="0,0,0,14">
                                <!-- Downloaded Music Item -->
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🎵" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Downloaded Songs" FontSize="13" Foreground="#DDD" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="StorageDownloadsCountText" Text="" FontSize="11" Foreground="#666" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="StorageDownloadsSizeText" Text="-- MB" FontSize="13" FontFamily="{StaticResource MontserratSemiBold}" Foreground="#FFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Image Cache Item -->
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🖼️" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Image Cache" FontSize="13" Foreground="#DDD" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="StorageImagesCountText" Text="" FontSize="11" Foreground="#666" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="StorageImagesSizeText" Text="-- MB" FontSize="13" FontFamily="{StaticResource MontserratSemiBold}" Foreground="#FFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Temp Stream Files Item -->
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚡" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Temporary Streams" FontSize="13" Foreground="#DDD" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="StorageTempCountText" Text="" FontSize="11" Foreground="#666" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="StorageTempSizeText" Text="-- MB" FontSize="13" FontFamily="{StaticResource MontserratSemiBold}" Foreground="#FFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Data & Database Item -->
                                <Grid Margin="0,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📄" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="App Data &amp; Playlists" FontSize="13" Foreground="#DDD" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="StorageDataSizeText" Text="-- KB" FontSize="13" FontFamily="{StaticResource MontserratSemiBold}" Foreground="#FFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>

                            <!-- Primary Action: Clean All Cache (Safe) -->
                            <Button Click="CleanAllCache_Click" Style="{StaticResource CategoryButtonStyle}" Margin="0,0,0,8" Height="44">
                                <Border Background="#1DB954" CornerRadius="12">
                                    <Grid Margin="16,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE107;" FontFamily="Segoe UI Symbol" FontSize="13" Foreground="Black" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Clean All Cache" FontFamily="{StaticResource MontserratBold}" FontSize="14" Foreground="Black" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- Secondary Action 1: Clear Image Cache -->
                            <Button Click="ClearCache_Click" Style="{StaticResource CategoryButtonStyle}" Margin="0,0,0,8" Height="40">
                                <Border Background="#252525" CornerRadius="10">
                                    <Grid Margin="16,0">
                                        <TextBlock Text="Clear Image Cache" FontFamily="{StaticResource MontserratSemiBold}" FontSize="13" Foreground="#CCC" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- Secondary Action 2: Clear Temp Streams -->
                            <Button Click="ClearTempStreams_Click" Style="{StaticResource CategoryButtonStyle}" Margin="0,0,0,8" Height="40">
                                <Border Background="#252525" CornerRadius="10">
                                    <Grid Margin="16,0">
                                        <TextBlock Text="Clear Temporary Streams" FontFamily="{StaticResource MontserratSemiBold}" FontSize="13" Foreground="#CCC" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- Secondary Action 3: Clear History -->
                            <Button Click="ClearRecentHistory_Click" Style="{StaticResource CategoryButtonStyle}" Margin="0,0,0,0" Height="40">
                                <Border Background="#2A1215" CornerRadius="10">
                                    <Grid Margin="16,0">
                                        <TextBlock Text="Clear Recent History" FontFamily="{StaticResource MontserratSemiBold}" FontSize="13" Foreground="#FF6B6B" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Button>

                        </StackPanel>
                    </Border>



                    <!-- ═══════ ABOUT ═══════ -->
                    <Border Background="#1A1A1A" CornerRadius="16" Margin="0,0,0,16" Padding="18,18">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="YTMusicWP" FontSize="22" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="#1DB954" HorizontalAlignment="Center"/>
                            <TextBlock Text="Version 2.2.0 BETA" FontSize="12" Foreground="#555" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Text="A music streaming client for Windows Phone 8.1" FontSize="12" Foreground="#444" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock Text="Made with ♥" FontSize="11" Foreground="#333" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══════════════════════════════════ PLAYLIST DETAILS ═══════════════════════════════════ -->
        <Grid x:Name="MoodCategoryView" Grid.Row="0" Visibility="Collapsed" Canvas.ZIndex="50" Background="#121212">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,15,10,10">
                <Button Click="CloseMoodCategory_Click" Style="{StaticResource IconButtonStyle}" Width="50" Height="50">
                    <Viewbox Width="20" Height="20"><Path Data="M20,11V13H8L13.5,18.5 12.08,19.92 4.16,12 12.08,4.08 13.5,5.5 8,11H20Z" Fill="White"/></Viewbox>
                </Button>
                <TextBlock x:Name="MoodCategoryTitle" Text="Category" FontSize="26" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            
            <Grid Grid.Row="1">
                <ProgressBar x:Name="MoodCategoryLoading" IsIndeterminate="True" VerticalAlignment="Top" Visibility="Collapsed" Foreground="#1DB954"/>
                <ListView x:Name="MoodCategorySectionList" SelectionMode="None" IsItemClickEnabled="False" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollMode="Auto" ItemTemplateSelector="{StaticResource HomeSectionSelector}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </Grid>

        <Grid x:Name="PlaylistDetailsView" Grid.Row="0" Visibility="Collapsed" Canvas.ZIndex="50" Background="#121212">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="PlaylistTransform" Y="1000"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Click="ClosePlaylistDetails_Click" Style="{StaticResource IconButtonStyle}" Width="50" Height="50" Margin="10,15,0,0" HorizontalAlignment="Left">
                <Viewbox Width="20" Height="20"><Path Data="M20,11V13H8L13.5,18.5 12.08,19.92 4.16,12 12.08,4.08 13.5,5.5 8,11H20Z" Fill="White"/></Viewbox>
            </Button>
            <StackPanel Grid.Row="1" Margin="20,0,20,20">
                <Rectangle x:Name="PlaylistDetailsCoverRect" Width="220" Height="220" RadiusX="10" RadiusY="10" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,10">
                    <Rectangle.Fill>
                        <ImageBrush x:Name="PlaylistDetailsCoverBrush" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock x:Name="PlaylistDetailsTitle" Text="Playlist Name" FontSize="26" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock x:Name="PlaylistDetailsSubtitle" Text="Subtitle" FontSize="14" FontFamily="{StaticResource MontserratSemiBold}" Foreground="White" TextAlignment="Center" Margin="0,5,0,0"/>
                <TextBlock x:Name="PlaylistDetailsTrackCount" Text="0 tracks" FontSize="14" Foreground="#B3B3B3" TextAlignment="Center" Margin="0,5,0,0"/>
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="▶ Play All" Click="PlayAllPlaylist_Click" Background="#1DB954" Foreground="Black" FontWeight="Bold" Width="130" Height="45">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="22">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="1" Click="EnhancePlaylist_Click" Style="{StaticResource IconButtonStyle}" Width="45" Height="45" Margin="10,0,0,0">
                        <TextBlock Text="✨" FontSize="22" Foreground="#1DB954"/>
                    </Button>
                    <Button Grid.Column="2" Click="PlaylistPinToStart_Click" Style="{StaticResource IconButtonStyle}" Width="45" Height="45" Margin="8,0,0,0" ToolTipService.ToolTip="Pin to Start">
                        <TextBlock Text="📌" FontSize="20" Foreground="White"/>
                    </Button>
                    <Button Grid.Column="3" Click="PlaylistSearchToggle_Click" Style="{StaticResource IconButtonStyle}" Width="45" Height="45" Margin="8,0,0,0" ToolTipService.ToolTip="Filter songs">
                        <TextBlock Text="🔍" FontSize="18" Foreground="White"/>
                    </Button>
                    <Button Grid.Column="5" Content="⋮" Foreground="#B3B3B3" FontSize="24" Style="{StaticResource IconButtonStyle}" Width="45" Height="45">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="📌 Pin to Start Screen" Click="PlaylistPinToStart_Click"/>
                                <MenuFlyoutItem Text="💾 Export to M3U" Click="ExportPlaylistM3u_Click"/>
                                <MenuFlyoutItem Text="✖ Delete Playlist" Click="MenuDeletePlaylistInside_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <!-- Quick Filter Bar -->
                <Grid x:Name="PlaylistFilterContainer" Margin="0,15,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PlaylistFilterBox" PlaceholderText="Find in playlist..." 
                             TextChanged="PlaylistFilterBox_TextChanged"
                             Background="#242424" Foreground="White" BorderThickness="0"
                             FontSize="14" Height="42" Padding="12,8" Margin="0"/>
                    <Button Grid.Column="1" Click="PlaylistFilterClear_Click" Style="{StaticResource IconButtonStyle}" Width="42" Height="42" Margin="6,0,0,0">
                        <TextBlock Text="✕" FontSize="16" Foreground="#B3B3B3"/>
                    </Button>
                </Grid>
            </StackPanel>
            <ListView x:Name="PlaylistSongsList" Grid.Row="2" Margin="20,0,20,0" Padding="0" IsItemClickEnabled="True" ItemClick="SongList_ItemClick" SelectionMode="None" ItemTemplate="{StaticResource PlaylistSongItemTemplate}" ItemContainerStyle="{StaticResource StretchItemStyle}" VirtualizingStackPanel.VirtualizationMode="Recycling"/>
        </Grid>

        <!-- ═══════════════════════════════════ MUSIC SHORTS VIEW ═══════════════════════════════════ -->
        <Grid x:Name="ShortsView" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Canvas.ZIndex="55" Background="#0A0A0A"
              ManipulationMode="TranslateX,TranslateY" ManipulationDelta="Shorts_ManipulationDelta" ManipulationCompleted="Shorts_ManipulationCompleted">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ShortsTransform" Y="1000"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: Back + Category + Pause -->
            <Grid Grid.Row="0" Margin="0,30,0,0" Canvas.ZIndex="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Click="ShortsBack_Click" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0" Padding="8">
                    <TextBlock Text="←" FontSize="26" Foreground="White"/>
                </Button>
                <TextBlock x:Name="ShortsCategoryTitle" Grid.Column="1" Text="#edm" FontSize="17" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Click="ShortsPlayCurrent_Click" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" Padding="8">
                    <TextBlock x:Name="ShortsPauseBtn" Text="❚❚" FontSize="22" Foreground="White"/>
                </Button>
            </Grid>

            <!-- Category Dots -->
            <StackPanel x:Name="ShortsCategoryDots" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,72,0,5">
                <!-- Dots populated dynamically -->
            </StackPanel>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="0">
                <!-- Blurred background: very low-res image stretched = natural blur -->
                <Grid.Background>
                    <ImageBrush x:Name="ShortsBlurBg" Stretch="UniformToFill" Opacity="0.6"/>
                </Grid.Background>
                <!-- Dark frost overlay on top of blurred bg -->
                <Border Background="#88000000"/>

                <!-- Cover Art (music-only mode) — centered with waveform bars -->
                <Grid x:Name="ShortsCoverArtPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Fake waveform bars left -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-65,0,0,0" Opacity="0.5">
                        <Border Width="4" Height="35" Background="#B3B3B3" CornerRadius="2" Margin="3,0"/>
                        <Border Width="4" Height="55" Background="#B3B3B3" CornerRadius="2" Margin="3,0"/>
                        <Border Width="4" Height="25" Background="#B3B3B3" CornerRadius="2" Margin="3,0"/>
                        <Border Width="4" Height="65" Background="#B3B3B3" CornerRadius="2" Margin="3,0"/>
                        <Border Width="4" Height="40" Background="#B3B3B3" CornerRadius="2" Margin="3,0"/>
                        <Border Width="4" Height="50" Background="#B3B3B3" CornerRadius="2" Margin="3,0"/>
                    </StackPanel>
                    <!-- Cover Art (square album style) -->
                    <Border Width="220" Height="220" CornerRadius="12">
                        <Border.Background>
                            <ImageBrush x:Name="ShortsCoverArt" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <!-- Fake waveform bars right -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-65,0" Opacity="0.5">
                        <Border Width="4" Height="45" Background="#B3B3B3" CornerRadius="2" Margin="3,0"/>
                        <Border Width="4" Height="25" Background="#B3B3B3" CornerRadius="2" Margin="3,0"/>
                        <Border Width="4" Height="60" Background="#B3B3B3" CornerRadius="2" Margin="3,0"/>
                        <Border Width="4" Height="35" Background="#B3B3B3" CornerRadius="2" Margin="3,0"/>
                        <Border Width="4" Height="55" Background="#B3B3B3" CornerRadius="2" Margin="3,0"/>
                        <Border Width="4" Height="30" Background="#B3B3B3" CornerRadius="2" Margin="3,0"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Bottom Info Panel -->
            <StackPanel Grid.Row="2" Margin="15,0,15,0">
                <!-- Artist info -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Ellipse x:Name="ShortsArtistAvatar" Width="36" Height="36" VerticalAlignment="Center">
                        <Ellipse.Fill><ImageBrush x:Name="ShortsArtistAvatarBrush" Stretch="UniformToFill"/></Ellipse.Fill>
                    </Ellipse>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ShortsArtistName" Text="Artist" FontSize="15" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="ShortsArtistSub" Text="" FontSize="11" Foreground="#999999"/>
                    </StackPanel>
                </StackPanel>

                <!-- Hashtags -->
                <StackPanel x:Name="ShortsHashtags" Orientation="Horizontal" Margin="0,0,0,10">
                    <!-- Populated dynamically -->
                </StackPanel>

                <!-- Mini player bar -->
                <Border Background="#2A2A2A" CornerRadius="12" Margin="0,0,0,15" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <!-- Tappable song info → play in main player -->
                        <Grid Grid.Column="0" Tapped="ShortsSongBar_Tapped">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="6">
                                <Border.Background><ImageBrush x:Name="ShortsMiniCover" Stretch="UniformToFill"/></Border.Background>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock x:Name="ShortsSongTitle" Text="Song Title" FontSize="14" FontFamily="{StaticResource MontserratSemiBold}" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ShortsSongArtist" Text="Artist" FontSize="11" Foreground="#999999" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                        <!-- Heart/Favorite button -->
                        <Button Grid.Column="1" Click="ShortsHeart_Click" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center">
                            <TextBlock x:Name="ShortsHeartBtn" Text="♡" FontSize="22" Foreground="White"/>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════ ARTIST PROFILE VIEW ═══════════════════════════════════ -->
        <Grid x:Name="ArtistProfileView" Grid.Row="0" Visibility="Collapsed" Canvas.ZIndex="45" Background="#121212">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ArtistTransform" Y="1000"/>
            </Grid.RenderTransform>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- ======= HERO HEADER ======= -->
                    <Grid Height="340">
                        <Image x:Name="ArtistProfileCover" Stretch="UniformToFill"/>
                        <!-- Dark gradient overlay bottom -->
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0.0"/>
                                    <GradientStop Color="#60121212" Offset="0.55"/>
                                    <GradientStop Color="#FF121212" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!-- Back button -->
                        <Button Click="CloseArtistProfile_Click" Style="{StaticResource IconButtonStyle}" Width="44" Height="44" Margin="8,25,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Viewbox Width="18" Height="18"><Path Data="M20,11V13H8L13.5,18.5 12.08,19.92 4.16,12 12.08,4.08 13.5,5.5 8,11H20Z" Fill="White"/></Viewbox>
                        </Button>
                        <!-- Artist name + listeners at bottom -->
                        <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,16">
                            <TextBlock x:Name="ArtistProfileTitle" Text="Artist" FontSize="32" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ArtistMonthlyListeners" Text="" FontSize="13" Foreground="#B3B3B3" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- ======= ACTION ROW ======= -->
                    <Grid Margin="16,8,16,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Follow button (outline) -->
                        <Button x:Name="ArtistFollowBtn" Grid.Column="0" Click="ArtistFollow_Click" Content="Follow" FontSize="13" FontFamily="{StaticResource MontserratSemiBold}" Foreground="White" VerticalAlignment="Center" MinHeight="36" MinWidth="80">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="4" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" Padding="16,8" Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Play button (green filled circle - same as Now Playing) -->
                        <Button Grid.Column="1" Click="ArtistPlayAll_Click" Style="{StaticResource IconButtonStyle}" Width="46" Height="46" Margin="16,0,0,0">
                            <Border Width="46" Height="46" CornerRadius="23" Background="#1DB954">
                                <SymbolIcon Symbol="Play" Foreground="Black"/>
                            </Border>
                        </Button>
                        <!-- Shuffle button (same icon as Now Playing) -->
                        <Button Grid.Column="2" Click="ArtistShuffle_Click" Style="{StaticResource IconButtonStyle}" Width="44" Height="44" Margin="6,0,0,0">
                            <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE14B;" Foreground="White" FontSize="20"/>
                        </Button>
                        <!-- Loading bar -->
                        <ProgressBar x:Name="ArtistLoadingBar" Grid.Column="3" IsIndeterminate="True" Visibility="Collapsed" Foreground="#1DB954" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>

                    <!-- ======= PHỔ BIẾN (Popular) ======= -->
                    <TextBlock Text="Popular" FontSize="18" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White" Margin="16,14,16,6"/>

                    <!-- Songs list -->
                    <ListView x:Name="ArtistSongsList" IsItemClickEnabled="True" ItemClick="SongList_ItemClick" SelectionMode="None" ItemTemplate="{StaticResource SongItemTemplate}" ItemContainerStyle="{StaticResource StretchItemStyle}" VirtualizingStackPanel.VirtualizationMode="Recycling" Margin="6,0,6,0"/>

                    <!-- ======= SECTIONS (Albums, Singles, Videos, etc.) ======= -->
                    <ItemsControl x:Name="ArtistSectionsControl" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="{Binding Title}" FontSize="18" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White" Margin="16,0,16,8"/>
                                    <ListView ItemsSource="{Binding Items}" IsItemClickEnabled="True" ItemClick="ArtistAlbum_ItemClick" SelectionMode="None" ItemTemplate="{StaticResource ArtistAlbumItemTemplate}" ItemContainerStyle="{StaticResource HorizontalItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollMode="Disabled" Margin="16,0,0,0">
                                        <ListView.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
                                    </ListView>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ======= GIỚI THIỆU (About) ======= -->
                    <StackPanel x:Name="ArtistAboutSection" Visibility="Collapsed" Margin="16,16,16,8">
                        <TextBlock Text="About" FontSize="18" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                        <Border CornerRadius="12" MinHeight="200" Background="#1A1A1A" Tapped="ArtistAbout_Tapped">
                            <Grid>
                                <Border CornerRadius="12">
                                    <Border.Background>
                                        <ImageBrush x:Name="ArtistAboutImage" Stretch="UniformToFill" Opacity="0.5"/>
                                    </Border.Background>
                                </Border>
                                <Rectangle RadiusX="12" RadiusY="12">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.2"/>
                                            <GradientStop Color="#DD000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <StackPanel VerticalAlignment="Bottom" Margin="16,16,16,16">
                                    <TextBlock x:Name="ArtistAboutListeners" FontSize="16" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="followers" FontSize="12" Foreground="#B3B3B3" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="ArtistAboutDescription" FontSize="12" Foreground="#CCCCCC" Margin="0,8,0,0" MaxLines="3" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Bottom padding for mini player -->
                    <Rectangle Height="20"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══════════════════════════════════ MINI PLAYER (Row 1) ═══════════════════════════════════ -->
        <Grid Grid.Row="1">
            <!-- Mini player green accent top line -->
            <Rectangle Height="2" VerticalAlignment="Top" Canvas.ZIndex="5">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#1DB954" Offset="0"/>
                        <GradientStop Color="#1DB954" Offset="0.5"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Border Background="#181818" Padding="10,8,10,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="MiniPlayerInfoGrid" Grid.Column="0" Background="Transparent"
                          Tapped="MiniPlayer_Tapped"
                          ManipulationMode="TranslateX,System"
                          ManipulationDelta="MiniPlayer_ManipulationDelta"
                          ManipulationCompleted="MiniPlayer_ManipulationCompleted">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="MiniPlayerTranslate" X="0"/>
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle x:Name="MiniCoverRectangle" Grid.Column="0" Width="46" Height="46" RadiusX="8" RadiusY="8" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Rectangle.Fill>
                                <ImageBrush x:Name="MiniCoverImage" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
                            </Rectangle.Fill>
                        </Rectangle>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock x:Name="MiniTitle" Text="Not playing" FontSize="15" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="MiniArtist" Text="Select a song" FontSize="13" Foreground="#B3B3B3" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                    <Button x:Name="MiniPlayPauseBtn" Grid.Column="1" Click="PlayPauseButton_Click" Style="{StaticResource IconButtonStyle}" Width="50">
                        <SymbolIcon x:Name="MiniPlayIcon" Symbol="Play" Foreground="White"/>
                    </Button>
                    <Button Grid.Column="2" Click="NextButton_Click" Style="{StaticResource IconButtonStyle}" Width="50">
                        <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE101;" Foreground="White" FontSize="20"/>
                    </Button>
                </Grid>
            </Border>
            <ProgressBar x:Name="MiniProgressBar" VerticalAlignment="Bottom" Height="2" Minimum="0" Maximum="100" Value="0" Foreground="#1DB954" Background="#333333" BorderThickness="0" IsHitTestVisible="False"/>
        </Grid>

        <!-- ═══════════════════════════════════ BOTTOM NAV (Row 2) ═══════════════════════════════════ -->
        <Border Grid.Row="2" Background="#0D0D0D" BorderBrush="#1F1F1F" BorderThickness="0,1,0,0" Padding="0,8,0,10" Canvas.ZIndex="96">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Home -->
                <Button Grid.Column="0" Click="NavHome_Click" Style="{StaticResource IconButtonStyle}" MinHeight="0">
                    <StackPanel HorizontalAlignment="Center">
                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center">
                            <Path x:Name="NavHomeIcon" Fill="White" Stretch="Uniform" Data="M12,2 L3,10 L3,22 L9,22 L9,16 L15,16 L15,22 L21,22 L21,10 Z"/>
                        </Viewbox>
                        <TextBlock x:Name="NavHomeText" Text="Home" FontSize="10" Foreground="White" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
                <!-- Search -->
                <Button Grid.Column="1" Click="NavSearch_Click" Style="{StaticResource IconButtonStyle}" MinHeight="0">
                    <StackPanel HorizontalAlignment="Center">
                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center">
                            <Path x:Name="NavSearchIcon" Fill="#B3B3B3" Stretch="Uniform" Data="M9.5,2 C5.36,2 2,5.36 2,9.5 C2,13.64 5.36,17 9.5,17 C11.24,17 12.84,16.41 14.12,15.42 L19.35,20.65 L20.65,19.35 L15.42,14.12 C16.41,12.84 17,11.24 17,9.5 C17,5.36 13.64,2 9.5,2 Z M9.5,4.5 C12.26,4.5 14.5,6.74 14.5,9.5 C14.5,12.26 12.26,14.5 9.5,14.5 C6.74,14.5 4.5,12.26 4.5,9.5 C4.5,6.74 6.74,4.5 9.5,4.5 Z"/>
                        </Viewbox>
                        <TextBlock x:Name="NavSearchText" Text="Search" FontSize="10" Foreground="#B3B3B3" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
                <!-- Library -->
                <Button Grid.Column="2" Click="NavLibrary_Click" Style="{StaticResource IconButtonStyle}" MinHeight="0">
                    <StackPanel HorizontalAlignment="Center">
                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center">
                            <Path x:Name="NavLibraryIcon" Fill="#B3B3B3" Stretch="Uniform" Data="M3,21 L3,3 L6,3 L6,21 Z M10,21 L10,3 L13,3 L13,21 Z M17,21 L17,7 L20,7 L20,21 Z"/>
                        </Viewbox>
                        <TextBlock x:Name="NavLibraryText" Text="Library" FontSize="10" Foreground="#B3B3B3" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
                <!-- Create -->
                <Button Grid.Column="3" Click="NavCreate_Click" Style="{StaticResource IconButtonStyle}" MinHeight="0">
                    <StackPanel HorizontalAlignment="Center">
                        <Grid HorizontalAlignment="Center" Width="22" Height="22">
                            <Ellipse x:Name="NavCreateCircle" Width="28" Height="28" Margin="-3" Fill="White" Visibility="Collapsed"/>
                            <Viewbox x:Name="NavCreateViewbox" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Viewbox.RenderTransform>
                                    <RotateTransform x:Name="NavCreateRotate" Angle="0"/>
                                </Viewbox.RenderTransform>
                                <Path x:Name="NavCreateIcon" Fill="#B3B3B3" Stretch="Uniform" Data="M11,2 L13,2 L13,11 L22,11 L22,13 L13,13 L13,22 L11,22 L11,13 L2,13 L2,11 L11,11 Z"/>
                            </Viewbox>
                        </Grid>
                        <TextBlock x:Name="NavCreateText" Text="Create" FontSize="10" Foreground="#B3B3B3" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════ CREATE FLOATING MENU ═══════════════════════════════════ -->
        <Grid x:Name="CreateBottomSheet" Visibility="Collapsed" Canvas.ZIndex="90" Grid.RowSpan="3" Tapped="CloseCreateSheet_Tapped">
            <Rectangle Fill="#80000000"/>
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Background="#282828" CornerRadius="12,12,0,0" Padding="6,8,6,8" Margin="12,0,12,52">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="CreateSheetTransform" Y="200"/>
                </Border.RenderTransform>
                <StackPanel>
                    <!-- Option 1: Create Playlist -->
                    <Button Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="CreateSheet_Playlist_Click">
                        <Grid Margin="6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="24" Background="#3E3E3E">
                                <Viewbox Width="20" Height="20">
                                    <Path Fill="White" Stretch="Uniform" Data="M19,11 L13,11 L13,5 L11,5 L11,11 L5,11 L5,13 L11,13 L11,19 L13,19 L13,13 L19,13 Z"/>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="Playlist" FontSize="16" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Create a playlist with songs or podcast episodes" FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Option 2: Collaborative Playlist -->
                    <Button Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="CreateSheet_Collab_Click">
                        <Grid Margin="6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="24" Background="#3E3E3E">
                                <Viewbox Width="20" Height="20">
                                    <Path Fill="White" Stretch="Uniform" Data="M16,11 C17.66,11 18.99,9.66 18.99,8 C18.99,6.34 17.66,5 16,5 C14.34,5 13,6.34 13,8 C13,9.66 14.34,11 16,11 Z M8,11 C9.66,11 10.99,9.66 10.99,8 C10.99,6.34 9.66,5 8,5 C6.34,5 5,6.34 5,8 C5,9.66 6.34,11 8,11 Z M8,13 C5.67,13 1,14.17 1,16.5 L1,19 L15,19 L15,16.5 C15,14.17 10.33,13 8,13 Z M16,13 C15.71,13 15.38,13.02 15.03,13.05 C16.19,13.89 17,15.02 17,16.5 L17,19 L23,19 L23,16.5 C23,14.17 18.33,13 16,13 Z"/>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="Collaborative playlist" FontSize="16" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Create a playlist together with friends" FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Option 3: Blend -->
                    <Button Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="CreateSheet_Blend_Click">
                        <Grid Margin="6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="24" Background="#3E3E3E">
                                <Viewbox Width="20" Height="20">
                                    <Path Fill="White" Stretch="Uniform" Data="M12,3 C7.03,3 3,7.03 3,12 C3,16.97 7.03,21 12,21 C16.97,21 21,16.97 21,12 C21,7.03 16.97,3 12,3 Z M12,5 C13.66,5 15.17,5.58 16.38,6.53 L12,10.91 L7.62,6.53 C8.83,5.58 10.34,5 12,5 Z M5,12 C5,10.34 5.58,8.83 6.53,7.62 L10.91,12 L6.53,16.38 C5.58,15.17 5,13.66 5,12 Z M12,19 C10.34,19 8.83,18.42 7.62,17.47 L12,13.09 L16.38,17.47 C15.17,18.42 13.66,19 12,19 Z M17.47,16.38 L13.09,12 L17.47,7.62 C18.42,8.83 19,10.34 19,12 C19,13.66 18.42,15.17 17.47,16.38 Z"/>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="Blend" FontSize="16" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Create a playlist that combines music tastes with friends" FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════ NOW PLAYING VIEW ═══════════════════════════════════ -->
        <Grid x:Name="NowPlayingView" Background="#FF000000" Visibility="Collapsed" Canvas.ZIndex="100" Grid.RowSpan="3">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="NowPlayingTransform" Y="1000"/>
            </Grid.RenderTransform>
            <!-- Solid black base to ensure Home screen never bleeds through -->
            <Rectangle Fill="#FF000000" />
            <!-- Gradient background (genre-based color) -->
            <Rectangle x:Name="DefaultNowPlayingBackground">
                <Rectangle.Fill>
                    <LinearGradientBrush x:Name="NowPlayingGradient" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop x:Name="NowPlayingGradientTop" Color="#1A1A2E" Offset="0"/>
                        <GradientStop x:Name="NowPlayingGradientMid" Color="#121212" Offset="0.55"/>
                        <GradientStop Color="#0D0D0D" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- Apple Music: frosted artwork backdrop (Collapsed by default, shown by code) -->
            <Image x:Name="AppleMusicBackdrop" Stretch="UniformToFill" Visibility="Collapsed"/>
            <!-- Apple Music: tinted gradient wash over the blur -->
            <Rectangle x:Name="AppleMusicWash" Opacity="0.72" Visibility="Collapsed">
                <Rectangle.Fill>
                    <LinearGradientBrush x:Name="AppleMusicWashGradient" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop x:Name="AppleMusicGradTop" Color="#1A1A2E" Offset="0"/>
                        <GradientStop x:Name="AppleMusicGradMid" Color="#121212" Offset="0.48"/>
                        <GradientStop x:Name="AppleMusicGradBot" Color="#0D0D0D" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Grid Canvas.ZIndex="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Apple Music: full-bleed artwork with gentle bottom fade -->
                <Grid x:Name="AppleMusicArtworkGrid" Grid.Row="0" Grid.RowSpan="2" Canvas.ZIndex="15" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="480" ManipulationMode="TranslateX" ManipulationStarted="AppleMusicArtworkGrid_ManipulationStarted" ManipulationCompleted="AppleMusicArtworkGrid_ManipulationCompleted">
                    <Image x:Name="AppleMusicArtwork" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="480"/>
                    <!-- Apple Music: top status bar scrim for icon readability over bright artwork -->
                    <Rectangle VerticalAlignment="Top" Height="38" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#38000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle x:Name="AppleMusicArtworkFade" VerticalAlignment="Bottom" Height="260" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop x:Name="AppleMusicArtFadeTop" Color="#00000000" Offset="0"/>
                                <GradientStop x:Name="AppleMusicArtFadeMid" Color="#80000000" Offset="0.5"/>
                                <GradientStop x:Name="AppleMusicArtFadeBot" Color="#FF121212" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- Apple Music: grabber bar (floating at top in AM mode) -->
                <Border x:Name="AppleMusicGrabber" Visibility="Collapsed" Grid.Row="0" Canvas.ZIndex="30" Background="Transparent" Tapped="CloseNowPlaying_Click" Height="32" VerticalAlignment="Top" Margin="0,28,0,0">
                    <Border Background="#59FFFFFF" CornerRadius="3" Width="36" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Grid x:Name="DefaultNowPlayingHeader" Grid.Row="0" Margin="0,20,0,0" Height="70">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Click="CloseNowPlaying_Click" Style="{StaticResource IconButtonStyle}" Background="#01000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Viewbox Width="22" Height="22"><Path Data="M7.41,8.58L12,13.17 16.59,8.58 18,10 12,16 6,10Z" Fill="White"/></Viewbox>
                    </Button>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="NOW PLAYING" FontSize="11" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold" Foreground="#AAFFFFFF" CharacterSpacing="150" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Border Background="Transparent" Padding="8,6" Tapped="DotPlayer_Tapped">
                                <Ellipse x:Name="DotPlayer" Width="7" Height="7" Fill="#1DB954" Opacity="1.0"/>
                            </Border>
                            <Border Background="Transparent" Padding="8,6" Tapped="DotLyrics_Tapped">
                                <Ellipse x:Name="DotLyrics" Width="7" Height="7" Fill="White" Opacity="0.3"/>
                            </Border>
                            <Border Background="Transparent" Padding="8,6" Tapped="DotQueue_Tapped">
                                <Ellipse x:Name="DotQueue" Width="7" Height="7" Fill="White" Opacity="0.3"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Click="OpenNowPlayingMenu_Click" Style="{StaticResource IconButtonStyle}" Background="#01000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Viewbox Width="22" Height="22"><Path Data="M12,16A2,2 0 0,1 10,14A2,2 0 0,1 12,12A2,2 0 0,1 14,14A2,2 0 0,1 12,16M12,10A2,2 0 0,1 10,8A2,2 0 0,1 12,6A2,2 0 0,1 14,8A2,2 0 0,1 12,10M12,22A2,2 0 0,1 10,20A2,2 0 0,1 12,18A2,2 0 0,1 14,20A2,2 0 0,1 12,22Z" Fill="White"/></Viewbox>
                    </Button>
                </Grid>
                <Pivot x:Name="NowPlayingPivot" Grid.Row="1" Foreground="White" Margin="0" SelectionChanged="NowPlayingPivot_SelectionChanged">
                    <Pivot.HeaderTemplate>
                        <DataTemplate><Grid Height="0" Visibility="Collapsed"/></DataTemplate>
                    </Pivot.HeaderTemplate>
                    <Pivot.ItemContainerStyle>
                        <Style TargetType="PivotItem">
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </Pivot.ItemContainerStyle>
                    <!-- Player page -->
                    <PivotItem>
                        <Grid>
                            <Grid x:Name="DefaultNowPlayingArtwork" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-10,0,0">
                                <!-- Shadow effect -->
                                <Rectangle x:Name="BigCoverShadow" Width="290" Height="290" RadiusX="16" RadiusY="16" Fill="#40000000" Margin="10,10,0,0"/>
                                <!-- Album art -->
                                <Rectangle x:Name="BigCoverRectangle" Width="300" Height="300" RadiusX="16" RadiusY="16" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform>
                                        <CompositeTransform x:Name="BigCoverTransform" ScaleX="1" ScaleY="1"/>
                                    </Rectangle.RenderTransform>
                                    <Rectangle.Fill>
                                        <ImageBrush x:Name="BigCoverImage" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                        </Grid>
                    </PivotItem>
                    <!-- Lyrics page -->
                    <PivotItem>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Apple Music: compact header -->
                            <Grid x:Name="AppleMusicLyricsHeader" Grid.Row="0" Visibility="Collapsed" Height="70" Margin="15,10,15,0" VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Width="55" Height="55" RadiusX="4" RadiusY="4">
                                    <Rectangle.Fill>
                                        <ImageBrush x:Name="AppleMusicLyricsThumb" Stretch="UniformToFill"/>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock x:Name="AppleMusicLyricsTitle" Text="" FontSize="13" FontFamily="{StaticResource MontserratSemiBold}" Foreground="White" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                    <TextBlock x:Name="AppleMusicLyricsArtist" Text="" FontSize="12" Foreground="#B3B3B3" TextTrimming="CharacterEllipsis" MaxLines="1" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="AppleMusicLyricsHeartBtn" Content="♡" Click="HeartButton_Click" Style="{StaticResource IconButtonStyle}" Foreground="White" FontSize="22" Width="40" Height="40" Padding="0" MinWidth="0" MinHeight="0"/>
                                    <Button Click="OpenNowPlayingMenu_Click" Style="{StaticResource IconButtonStyle}" Width="40" Height="40" Padding="0" MinWidth="0" MinHeight="0">
                                        <Viewbox Width="18" Height="18"><Path Data="M12,16A2,2 0 0,1 10,14A2,2 0 0,1 12,12A2,2 0 0,1 14,14A2,2 0 0,1 12,16M12,10A2,2 0 0,1 10,8A2,2 0 0,1 12,6A2,2 0 0,1 14,8A2,2 0 0,1 12,10M12,22A2,2 0 0,1 10,20A2,2 0 0,1 12,18A2,2 0 0,1 14,20A2,2 0 0,1 12,22Z" Fill="White"/></Viewbox>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ProgressBar x:Name="LyricsLoadingBar" Grid.Row="0" IsIndeterminate="True" VerticalAlignment="Top" Visibility="Collapsed" Foreground="White"/>
                            <ScrollViewer x:Name="LyricsFallbackScrollViewer" Grid.Row="1" Visibility="Collapsed" Margin="15,20,15,60" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
                                <TextBlock x:Name="LyricsFallbackText" Text="Swipe to see lyrics..." Foreground="#B3B3B3" FontSize="16" TextWrapping="Wrap" TextAlignment="Left"/>
                            </ScrollViewer>
                            <ListView x:Name="LyricsListView" Grid.Row="1" IsItemClickEnabled="True" ItemClick="LyricsListView_ItemClick" SelectionMode="None" Margin="15,0" Padding="0,10,0,70" ShowsScrollingPlaceholders="False" ContainerContentChanging="LyricsListView_ContainerContentChanging">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,8" HorizontalAlignment="Left">
                                            <!-- Far-field blur taps (outer ring: radius 3.8px) -->
                                            <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="{Binding ColorBrush}" Opacity="{Binding FarBlurOpacity}" TextWrapping="Wrap" TextAlignment="Left" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Left" IsHitTestVisible="False">
                                                <TextBlock.RenderTransform><TranslateTransform X="-2.7" Y="-2.7"/></TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="{Binding ColorBrush}" Opacity="{Binding FarBlurOpacity}" TextWrapping="Wrap" TextAlignment="Left" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Left" IsHitTestVisible="False">
                                                <TextBlock.RenderTransform><TranslateTransform X="2.7" Y="-2.7"/></TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="{Binding ColorBrush}" Opacity="{Binding FarBlurOpacity}" TextWrapping="Wrap" TextAlignment="Left" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Left" IsHitTestVisible="False">
                                                <TextBlock.RenderTransform><TranslateTransform X="-2.7" Y="2.7"/></TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="{Binding ColorBrush}" Opacity="{Binding FarBlurOpacity}" TextWrapping="Wrap" TextAlignment="Left" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Left" IsHitTestVisible="False">
                                                <TextBlock.RenderTransform><TranslateTransform X="2.7" Y="2.7"/></TextBlock.RenderTransform>
                                            </TextBlock>

                                            <!-- Near-field blur taps (inner ring: radius 2.0px) -->
                                            <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="{Binding ColorBrush}" Opacity="{Binding BlurOpacity}" TextWrapping="Wrap" TextAlignment="Left" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Left" IsHitTestVisible="False">
                                                <TextBlock.RenderTransform><TranslateTransform X="-2.0" Y="0"/></TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="{Binding ColorBrush}" Opacity="{Binding BlurOpacity}" TextWrapping="Wrap" TextAlignment="Left" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Left" IsHitTestVisible="False">
                                                <TextBlock.RenderTransform><TranslateTransform X="2.0" Y="0"/></TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="{Binding ColorBrush}" Opacity="{Binding BlurOpacity}" TextWrapping="Wrap" TextAlignment="Left" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Left" IsHitTestVisible="False">
                                                <TextBlock.RenderTransform><TranslateTransform X="0" Y="-2.0"/></TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="{Binding ColorBrush}" Opacity="{Binding BlurOpacity}" TextWrapping="Wrap" TextAlignment="Left" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Left" IsHitTestVisible="False">
                                                <TextBlock.RenderTransform><TranslateTransform X="0" Y="2.0"/></TextBlock.RenderTransform>
                                            </TextBlock>

                                            <!-- Core Sharp Text layer -->
                                            <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="{Binding ColorBrush}" Opacity="{Binding Opacity}" TextWrapping="Wrap" TextAlignment="Left" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                            <Rectangle x:Name="LyricsBottomFadeRect" Grid.Row="1" Height="70" VerticalAlignment="Bottom" Margin="0,0,0,-1" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                        <GradientStop x:Name="LyricsFadeBottomStop0" Color="#121212" Offset="0"/>
                                        <GradientStop x:Name="LyricsFadeBottomStop1" Color="#00121212" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,15" Canvas.ZIndex="10">
                                <Button Content="A-" Click="DecreaseLyricsSize_Click" FontSize="14" FontWeight="Bold" Foreground="White" Background="#33FFFFFF" BorderThickness="0" BorderBrush="Transparent" MinHeight="35" MinWidth="50" Padding="0" Margin="0,0,10,0"/>
                                <Button Content="A+" Click="IncreaseLyricsSize_Click" FontSize="14" FontWeight="Bold" Foreground="White" Background="#33FFFFFF" BorderThickness="0" BorderBrush="Transparent" MinHeight="35" MinWidth="50" Padding="0" Margin="0,0,10,0"/>
                                <Button Content="⛶" Click="ToggleFullscreenLyrics_Click" FontSize="16" FontWeight="Bold" Foreground="White" Background="#33FFFFFF" BorderThickness="0" BorderBrush="Transparent" MinHeight="35" MinWidth="50" Padding="0"/>
                            </StackPanel>
                        </Grid>
                    </PivotItem>
                    <!-- Queue page -->
                    <PivotItem>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <!-- Apple Music: compact header -->
                                <Grid x:Name="AppleMusicQueueHeader" Visibility="Collapsed" Height="70" Margin="15,10,15,0" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Width="55" Height="55" RadiusX="4" RadiusY="4">
                                        <Rectangle.Fill>
                                            <ImageBrush x:Name="AppleMusicQueueThumb" Stretch="UniformToFill"/>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock x:Name="AppleMusicQueueTitle" Text="" FontSize="13" FontFamily="{StaticResource MontserratSemiBold}" Foreground="White" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        <TextBlock x:Name="AppleMusicQueueArtist" Text="" FontSize="12" Foreground="#B3B3B3" TextTrimming="CharacterEllipsis" MaxLines="1" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="AppleMusicQueueHeartBtn" Content="♡" Click="HeartButton_Click" Style="{StaticResource IconButtonStyle}" Foreground="White" FontSize="22" Width="40" Height="40" Padding="0" MinWidth="0" MinHeight="0"/>
                                        <Button Click="OpenNowPlayingMenu_Click" Style="{StaticResource IconButtonStyle}" Width="40" Height="40" Padding="0" MinWidth="0" MinHeight="0">
                                            <Viewbox Width="18" Height="18"><Path Data="M12,16A2,2 0 0,1 10,14A2,2 0 0,1 12,12A2,2 0 0,1 14,14A2,2 0 0,1 12,16M12,10A2,2 0 0,1 10,8A2,2 0 0,1 12,6A2,2 0 0,1 14,8A2,2 0 0,1 12,10M12,22A2,2 0 0,1 10,20A2,2 0 0,1 12,18A2,2 0 0,1 14,20A2,2 0 0,1 12,22Z" Fill="White"/></Viewbox>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <!-- Apple Music: queue action pills -->
                                <StackPanel x:Name="AppleMusicQueuePills" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="15,4,15,10">
                                    <Border Background="#3DFFFFFF" CornerRadius="20" Width="40" Height="40" Margin="0,0,8,0" HorizontalAlignment="Stretch" Tapped="QueueInfoPill_Tapped">
                                        <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE946;" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="#3DFFFFFF" CornerRadius="20" Width="40" Height="40" Margin="0,0,8,0" HorizontalAlignment="Stretch" Tapped="QueueAddPill_Tapped">
                                        <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE109;" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="AppleMusicShufflePill" Background="#3DFFFFFF" CornerRadius="20" Width="40" Height="40" Margin="0,0,8,0" HorizontalAlignment="Stretch" Tapped="ShuffleButton_Click">
                                        <FontIcon x:Name="AppleMusicShuffleIcon" FontFamily="Segoe UI Symbol" Glyph="&#xE14B;" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="AppleMusicRepeatPill" Background="#3DFFFFFF" CornerRadius="20" Width="40" Height="40" HorizontalAlignment="Stretch" Tapped="RepeatButton_Click">
                                        <FontIcon x:Name="AppleMusicRepeatIcon" FontFamily="Segoe UI Symbol" Glyph="&#xE1CD;" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                                <Grid Margin="15,15,15,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="UP NEXT" FontSize="14" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White" CharacterSpacing="50"/>
                                        <TextBlock x:Name="QueueCountText" Text="" FontSize="12" Foreground="#888888" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Content="Clear" Click="QueueClear_Click" Foreground="#888888" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="8,4" MinWidth="0" MinHeight="0"/>
                                </Grid>
                            </StackPanel>
                            <ListView Grid.Row="1" x:Name="QueueListView" Margin="15,0,15,10" IsItemClickEnabled="True" ItemClick="QueueListView_ItemClick" SelectionMode="None" ItemTemplate="{StaticResource QueueItemTemplate}" ItemContainerStyle="{StaticResource StretchItemStyle}" VirtualizingStackPanel.VirtualizationMode="Recycling" ShowsScrollingPlaceholders="False"/>
                        </Grid>
                    </PivotItem>
                </Pivot>
                <!-- Controls -->
                <StackPanel x:Name="DefaultNowPlayingControls" Grid.Row="2" Margin="25,0,25,30">
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <!-- Mini Lyric -->
                            <Canvas x:Name="MiniLyricCanvas" Height="22" Margin="0,0,0,6" SizeChanged="MiniLyricCanvas_SizeChanged">
                                <StackPanel x:Name="MiniLyricStack" Orientation="Horizontal" Opacity="0">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="MiniLyricTranslate" X="0"/>
                                    </StackPanel.RenderTransform>
                                    <TextBlock x:Name="MiniLyricText" Text="" FontSize="15" FontFamily="{StaticResource MontserratSemiBold}" Foreground="#E0E0E0" TextWrapping="NoWrap"/>
                                    <TextBlock x:Name="MiniLyricText2" Text="" FontSize="15" FontFamily="{StaticResource MontserratSemiBold}" Foreground="#E0E0E0" TextWrapping="NoWrap" Margin="50,0,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Canvas>
                            <Canvas x:Name="TitleMarqueeCanvas" Height="30" SizeChanged="TitleMarqueeCanvas_SizeChanged">
                                <TextBlock x:Name="BigTitle" Text="Title" FontSize="22" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White" CharacterSpacing="15" TextWrapping="NoWrap" Canvas.Top="0">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="TitleTranslate" X="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Canvas>
                            <TextBlock x:Name="BigArtist" Text="Artist" FontSize="16" Foreground="#B3B3B3" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="NowPlayingQueueBtn" Grid.Column="1" Click="QueueButton_Click" Style="{StaticResource IconButtonStyle}" Width="48" Height="48" VerticalAlignment="Center" Margin="0,0,4,0">
                            <SymbolIcon x:Name="QueueIcon" Symbol="List" Foreground="White"/>
                        </Button>
                        <Button x:Name="BigHeartBtn" Grid.Column="2" Content="♡" Click="HeartButton_Click" Style="{StaticResource IconButtonStyle}" Foreground="White" FontSize="32" Width="50" Height="50" Margin="5,0,0,0"/>
                    </Grid>
                    <StackPanel Margin="0,0,0,5">
                        <Slider x:Name="MusicSlider" Minimum="0" Maximum="100" Value="0" Margin="-5,-5,-5,-5" PointerCaptureLost="MusicSlider_PointerCaptureLost" PointerReleased="MusicSlider_PointerCaptureLost" PointerPressed="MusicSlider_PointerPressed" Foreground="#1DB954" Background="#404040" Style="{StaticResource ModernSliderStyle}"/>
                        <Grid Margin="0,-5,0,0">
                            <TextBlock x:Name="CurrentTimeText" Text="00:00" FontSize="12" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold" Foreground="#B3B3B3" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="TotalTimeText" Text="00:00" FontSize="12" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold" Foreground="#B3B3B3" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Click="ShuffleButton_Click" Style="{StaticResource IconButtonStyle}">
                            <StackPanel>
                                <FontIcon x:Name="ShuffleIcon" FontFamily="Segoe UI Symbol" Glyph="&#xE14B;" Foreground="White" FontSize="20"/>
                                <Ellipse x:Name="ShuffleDot" Width="4" Height="4" Fill="#1DB954" Margin="0,3,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Click="PrevButton_Click" Style="{StaticResource IconButtonStyle}">
                            <FontIcon FontFamily="Segoe UI Symbol" Glyph="&#xE100;" Foreground="White" FontSize="24"/>
