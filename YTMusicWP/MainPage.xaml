                        <Grid Margin="0,10,0,12" x:Name="HomeChartsTitle" Visibility="Collapsed">
                            <TextBlock Text="Top Charts" FontSize="22" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White" CharacterSpacing="20" Margin="10,0,0,0"/>
                        </Grid>
                        <ListView x:Name="HomeChartsCarousel" Height="210" IsItemClickEnabled="True" ItemClick="DiscoverItem_Click" SelectionMode="None" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Enabled" Visibility="Collapsed">
                            <ListView.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="10,0,0,0"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="115" Height="195" CornerRadius="8">
                                        <Border.Background>
                                            <ImageBrush Stretch="UniformToFill">
                                                <ImageBrush.ImageSource>
                                                    <BitmapImage UriSource="{Binding ThumbnailUrl}" DecodePixelWidth="180"/>
                                                </ImageBrush.ImageSource>
                                            </ImageBrush>
                                        </Border.Background>
                                        <!-- Title overlay at bottom -->
                                        <Border CornerRadius="0,0,8,8" VerticalAlignment="Bottom" Padding="8,15,8,8">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="Transparent" Offset="0"/>
                                                    <GradientStop Color="#CC000000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="11" FontFamily="{StaticResource MontserratSemiBold}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>
                                        </Border>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- ═══════ FOOTER CREDIT ═══════ -->
                        <TextBlock Text="@2026 YTMusicWP v2.2.0 Yasukoisreal" FontSize="11" Foreground="#555555" HorizontalAlignment="Center" Margin="0,30,0,10"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Podcasts content -->
                <Grid x:Name="HomePodcastPanel" Visibility="Collapsed">
                    <ProgressBar x:Name="PodcastLoading" IsIndeterminate="True" VerticalAlignment="Top" Visibility="Collapsed" Foreground="#1DB954" Canvas.ZIndex="5" Margin="0,115,0,0"/>
                    <ListView x:Name="PodcastList" Padding="0,115,0,0" IsItemClickEnabled="True" ItemClick="SongList_ItemClick" SelectionMode="None" ItemTemplate="{StaticResource SongItemTemplate}" ItemContainerStyle="{StaticResource StretchItemStyle}" Margin="10,0,0,10"/>
                </Grid>

                <!-- Audiobooks content -->
                <Grid x:Name="HomeAudiobookPanel" Visibility="Collapsed">
                    <ProgressBar x:Name="AudiobookLoading" IsIndeterminate="True" VerticalAlignment="Top" Visibility="Collapsed" Foreground="#1DB954" Canvas.ZIndex="5" Margin="0,115,0,0"/>
                    <ListView x:Name="AudiobookList" Padding="0,115,0,0" IsItemClickEnabled="True" ItemClick="SongList_ItemClick" SelectionMode="None" ItemTemplate="{StaticResource SongItemTemplate}" ItemContainerStyle="{StaticResource StretchItemStyle}" Margin="10,0,0,10"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════ SEARCH PANEL ═══════════════════════════════════ -->
        <Grid x:Name="SearchPanel" Grid.Row="0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search title -->
            <TextBlock Text="Search" FontSize="28" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White" Margin="15,15,0,10"/>

            <!-- Search bar with icon -->
            <Border Grid.Row="1" Margin="10,0,15,10" Height="46" Background="#1E1E1E" CornerRadius="23" BorderThickness="0" VerticalAlignment="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Background="Transparent" Tapped="SearchIcon_Tapped" Width="36" VerticalAlignment="Stretch">
                        <Viewbox Width="18" Height="18" Margin="14,0,0,0" HorizontalAlignment="Left"><Path Data="M15.5,14H14.71L14.43,13.73C15.41,12.59 16,11.11 16,9.5A6.5,6.5 0 0,0 9.5,3A6.5,6.5 0 0,0 3,9.5A6.5,6.5 0 0,0 9.5,16C11.11,16 12.59,15.41 13.73,14.43L14,14.71V15.5L19,20.49L20.49,19L15.5,14M9.5,14C7.01,14 5,11.99 5,9.5S7.01,5 9.5,5 14,7.01 14,9.5 11.99,14 9.5,14Z" Fill="#B3B3B3"/></Viewbox>
                    </Grid>
                    <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" PlaceholderText="What do you want to listen to?" Margin="6,0,0,0" InputScope="Search" Style="{StaticResource DarkTextBoxStyle}"/>
                    <Grid x:Name="SearchClearBtn" Grid.Column="2" Tapped="SearchClear_Click" VerticalAlignment="Center" Margin="0,0,14,0" Width="20" Height="20" Visibility="Collapsed">
                        <Ellipse Fill="#666666" Width="20" Height="20"/>
                        <Viewbox Width="10" Height="10"><Path Data="M1,0 L5,4 L9,0 L10,1 L6,5 L10,9 L9,10 L5,6 L1,10 L0,9 L4,5 L0,1 Z" Fill="White"/></Viewbox>
                    </Grid>
                </Grid>
