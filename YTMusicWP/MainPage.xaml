                                <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" FontStyle="{Binding FontStyle}" Foreground="{Binding ColorBrush}" Opacity="{Binding FarBlurOpacity}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.RenderTransform><TranslateTransform X="-1.5" Y="-1.5"/></TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" FontStyle="{Binding FontStyle}" Foreground="{Binding ColorBrush}" Opacity="{Binding FarBlurOpacity}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.RenderTransform><TranslateTransform X="1.5" Y="-1.5"/></TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" FontStyle="{Binding FontStyle}" Foreground="{Binding ColorBrush}" Opacity="{Binding FarBlurOpacity}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.RenderTransform><TranslateTransform X="-1.5" Y="1.5"/></TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" FontStyle="{Binding FontStyle}" Foreground="{Binding ColorBrush}" Opacity="{Binding FarBlurOpacity}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.RenderTransform><TranslateTransform X="1.5" Y="1.5"/></TextBlock.RenderTransform>
                                </TextBlock>

                                <!-- Cardinal blur taps (radius 2.0px) -->
                                <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" FontStyle="{Binding FontStyle}" Foreground="{Binding ColorBrush}" Opacity="{Binding BlurOpacity}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.RenderTransform><TranslateTransform X="-2.0" Y="0"/></TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" FontStyle="{Binding FontStyle}" Foreground="{Binding ColorBrush}" Opacity="{Binding BlurOpacity}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.RenderTransform><TranslateTransform X="2.0" Y="0"/></TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" FontStyle="{Binding FontStyle}" Foreground="{Binding ColorBrush}" Opacity="{Binding BlurOpacity}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.RenderTransform><TranslateTransform X="0" Y="-2.0"/></TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" FontStyle="{Binding FontStyle}" Foreground="{Binding ColorBrush}" Opacity="{Binding BlurOpacity}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.RenderTransform><TranslateTransform X="0" Y="2.0"/></TextBlock.RenderTransform>
                                </TextBlock>

                                <!-- Core Sharp Text layer -->
                                <TextBlock x:Name="FullscreenLyricSharpText" Text="{Binding Text}" FontSize="{Binding FontSize}" FontStyle="{Binding FontStyle}" Foreground="{Binding ColorBrush}" Opacity="{Binding Opacity}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Center" IsHitTestVisible="False"/>
                                <Canvas x:Name="FullscreenLyricWordLayer" IsHitTestVisible="False"/>
