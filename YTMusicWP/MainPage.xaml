        <!-- ═══════════════════════════════════ FULLSCREEN LYRICS ═══════════════════════════════════ -->
        <Grid x:Name="FullscreenLyricsView" Visibility="Collapsed" Canvas.ZIndex="120" Grid.RowSpan="3" Tapped="CloseFullscreenLyrics_Tapped">
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop x:Name="FullscreenLyricsGradientTop" Color="#1A1A2E" Offset="0"/>
                        <GradientStop x:Name="FullscreenLyricsGradientMid" Color="#0A0A0A" Offset="0.5"/>
                        <GradientStop Color="#121212" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Grid Margin="20,60,20,80">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Song info at top -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock x:Name="FullscreenLyricsTitle" Text="" FontSize="20" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="FullscreenLyricsArtist" Text="" FontSize="14" Foreground="#B3B3B3" TextAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <!-- Lyrics content -->
                <ListView x:Name="FullscreenLyricsListView" Grid.Row="1" SelectionMode="None" ShowsScrollingPlaceholders="False" ContainerContentChanging="FullscreenLyricsListView_ContainerContentChanging">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5,12" HorizontalAlignment="Center">
                                <!-- Far-field blur taps (outer ring: radius 3.8px) -->
                                <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="{Binding ColorBrush}" Opacity="{Binding FarBlurOpacity}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.RenderTransform><TranslateTransform X="-2.7" Y="-2.7"/></TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="{Binding ColorBrush}" Opacity="{Binding FarBlurOpacity}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.RenderTransform><TranslateTransform X="2.7" Y="-2.7"/></TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="{Binding ColorBrush}" Opacity="{Binding FarBlurOpacity}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.RenderTransform><TranslateTransform X="-2.7" Y="2.7"/></TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="{Binding ColorBrush}" Opacity="{Binding FarBlurOpacity}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.RenderTransform><TranslateTransform X="2.7" Y="2.7"/></TextBlock.RenderTransform>
                                </TextBlock>

                                <!-- Near-field blur taps (inner ring: radius 2.0px) -->
                                <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="{Binding ColorBrush}" Opacity="{Binding BlurOpacity}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.RenderTransform><TranslateTransform X="-2.0" Y="0"/></TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="{Binding ColorBrush}" Opacity="{Binding BlurOpacity}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.RenderTransform><TranslateTransform X="2.0" Y="0"/></TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="{Binding ColorBrush}" Opacity="{Binding BlurOpacity}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.RenderTransform><TranslateTransform X="0" Y="-2.0"/></TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="{Binding ColorBrush}" Opacity="{Binding BlurOpacity}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.RenderTransform><TranslateTransform X="0" Y="2.0"/></TextBlock.RenderTransform>
                                </TextBlock>

                                <!-- Core Sharp Text layer -->
                                <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="{Binding ColorBrush}" Opacity="{Binding Opacity}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
            <!-- Tap hint -->
            <TextBlock Text="Tap to close" FontSize="12" Foreground="#666666" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,25"/>
        </Grid>

