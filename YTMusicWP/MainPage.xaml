            <!-- Filter chips -->
            <ScrollViewer Grid.Row="1" Canvas.ZIndex="10" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" Margin="10,5,0,10">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="HomeChipAll" Background="#333333" CornerRadius="16" Padding="14,6" Margin="0,0,8,0" Tapped="HomeChipAll_Tapped">
                        <TextBlock Text="All" Foreground="White" FontSize="13" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold"/>
                    </Border>
                    <Border x:Name="HomeChipMusic" Background="#1DB954" CornerRadius="16" Padding="14,6" Margin="0,0,8,0" Tapped="HomeChipMusic_Tapped">
                        <TextBlock Text="Music" Foreground="White" FontSize="13" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold"/>
                    </Border>
                    <Border x:Name="HomeChipPodcasts" Background="#333333" CornerRadius="16" Padding="14,6" Margin="0,0,8,0" Tapped="HomeChipPodcasts_Tapped">
                        <TextBlock Text="Podcasts" Foreground="White" FontSize="13" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold"/>
                    </Border>
                    <Border x:Name="HomeChipAudiobooks" Background="#333333" CornerRadius="16" Padding="14,6" Tapped="HomeChipAudiobooks_Tapped">
