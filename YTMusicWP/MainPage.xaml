            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Click="CloseArtistPicker_Click" Style="{StaticResource IconButtonStyle}" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Border Grid.Row="1" Background="#252525" CornerRadius="20,20,0,0" Padding="0,10,0,15">
                <StackPanel>
                    <Rectangle Width="36" Height="4" Fill="#666666" RadiusX="2" RadiusY="2" Margin="0,5,0,12" HorizontalAlignment="Center"/>
                    <TextBlock Text="Go to Artist" FontSize="18" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White" Margin="20,0,20,12"/>
                    <ListView x:Name="ArtistPickerList" IsItemClickEnabled="True" ItemClick="ArtistPickerList_ItemClick" SelectionMode="None" MaxHeight="300">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="50" Margin="20,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Grid.Column="0" Width="22" Height="22" HorizontalAlignment="Left">
                                        <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" Fill="#B3B3B3"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="{Binding}" FontSize="16" FontFamily="{StaticResource MontserratSemiBold}" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Click="CloseArtistPicker_Click" Style="{StaticResource IconButtonStyle}" Height="45" Margin="0,5,0,5">
                        <TextBlock Text="Close" FontSize="16" Foreground="#B3B3B3" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════ DIALOGS ═══════════════════════════════════ -->
        <Grid x:Name="AddToPlaylistDialog" Visibility="Collapsed" Canvas.ZIndex="150" Background="#AA000000" Grid.RowSpan="3">
            <Border Background="#252525" CornerRadius="16" Width="300" MaxHeight="400" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <StackPanel>
                    <TextBlock Text="Add to Playlist" FontSize="18" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                    <ListView x:Name="DialogPlaylistList" MaxHeight="250" IsItemClickEnabled="True" ItemClick="DialogPlaylistList_ItemClick" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" FontSize="18" Foreground="White" Margin="0,12"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="Cancel" Click="CancelAddToPlaylist_Click" HorizontalAlignment="Stretch" Foreground="White" Margin="0,15,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <!-- 🔑 LOGIN - DEVICE CODE FLOW 🔑 -->
        <Grid x:Name="LoginWebContainer" Visibility="Collapsed" Canvas.ZIndex="300" Background="#121212" Grid.RowSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#282828" Padding="15">
                <Grid>
                    <TextBlock Text="Sign in with Google" Foreground="White" FontSize="18" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="✕" Click="CloseLoginWeb_Click" Foreground="White" FontSize="20" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0" MinWidth="0"/>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,20,24,30">
                    <!-- QR Code Card -->
                    <Border x:Name="DeviceCodeQrContainer" Background="White" CornerRadius="16" Padding="12" Width="196" Height="196" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Grid>
                            <Image x:Name="DeviceCodeQrImage" Stretch="Uniform" Width="172" Height="172"/>
                            <ProgressRing x:Name="DeviceCodeQrLoading" IsActive="True" Foreground="#1DB954" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                    <!-- Scan Instructions -->
                    <TextBlock Text="Scan QR code with your phone camera to sign in instantly" Foreground="White" FontSize="14" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    
                    <!-- Divider with OR -->
                    <Grid Margin="0,0,0,14">
                        <Rectangle Height="1" Fill="#333333" VerticalAlignment="Center"/>
                        <Border Background="#121212" Padding="12,0" HorizontalAlignment="Center">
                            <TextBlock Text="OR ENTER CODE MANUALLY" Foreground="#777777" FontSize="11" FontFamily="{StaticResource MontserratSemiBold}"/>
                        </Border>
                    </Grid>
                    
                    <!-- URL and Code in compact card -->
                    <Border Background="#1E1E1E" CornerRadius="12" Padding="16,12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="1. Go to google.com/device" Foreground="#B3B3B3" FontSize="13" TextAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="2. Enter this code:" Foreground="#B3B3B3" FontSize="13" TextAlignment="Center" Margin="0,0,0,8"/>
                            <Border Background="#282828" CornerRadius="8" Padding="12,8">
                                <TextBlock x:Name="DeviceCodeText" Text="----" Foreground="#1DB954" FontSize="22" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" TextAlignment="Center" CharacterSpacing="60" IsTextSelectionEnabled="True"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <!-- Status -->
                    <ProgressBar x:Name="DeviceCodeProgress" IsIndeterminate="True" Foreground="#1DB954" Margin="0,0,0,8"/>
                    <TextBlock x:Name="DeviceCodeStatus" Text="Waiting for you to sign in..." Foreground="#888888" FontSize="13" TextAlignment="Center" Margin="0,0,0,10"/>
                </StackPanel>
            </ScrollViewer>
            <!-- Hidden: old WebView (kept for code compatibility) -->
            <WebView x:Name="LoginWebView" Grid.Row="1" Visibility="Collapsed" NavigationStarting="LoginWebView_NavigationStarting" NavigationCompleted="LoginWebView_NavigationCompleted" NavigationFailed="LoginWebView_NavigationFailed"/>
            <ProgressBar x:Name="LoginWebLoading" Grid.Row="1" VerticalAlignment="Top" IsIndeterminate="True" Foreground="#1DB954" Visibility="Collapsed"/>
        </Grid>
        <Grid x:Name="CreatePlaylistDialog" Visibility="Collapsed" Canvas.ZIndex="150" Background="#AA000000" Grid.RowSpan="3">
            <Border Background="#252525" CornerRadius="16" Width="300" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <StackPanel>
                    <TextBlock Text="New Playlist" FontSize="18" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                    <TextBox x:Name="NewPlaylistNameTextBox" PlaceholderText="Playlist name..." Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="CancelCreatePlaylist_Click" Foreground="#B3B3B3" Margin="0,0,10,0"/>
                        <Button Content="Create" Click="ConfirmCreatePlaylist_Click" Foreground="#1DB954" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>


        <!-- ═══════════════════════════════════ TOAST ═══════════════════════════════════ -->
        <Border x:Name="ToastNotification" Canvas.ZIndex="200" Visibility="Collapsed" Background="#1DB954" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Padding="14,10" Margin="15,0,15,130" CornerRadius="12" Grid.RowSpan="3">
            <TextBlock x:Name="ToastText" Text="Message" Foreground="White" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold" FontSize="14" TextAlignment="Center"/>
        </Border>

        <!-- ═══════════════════════════════════ DOWNLOAD STATUS ═══════════════════════════════════ -->
        <Border x:Name="DownloadStatusBar" Canvas.ZIndex="200" Visibility="Collapsed" Background="#1DB954" VerticalAlignment="Top" HorizontalAlignment="Stretch" Padding="15,10" Margin="0,0,0,0" Grid.RowSpan="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="DownloadStatusText" Text="Downloading..." Foreground="White" FontFamily="{StaticResource MontserratSemiBold}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="DownloadProgressBar" Grid.Row="1" Minimum="0" Maximum="100" Value="0" Foreground="White" Background="#116D31"/>
            </Grid>
        </Border>
    </Grid>
</Page>

