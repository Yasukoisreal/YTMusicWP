                                            </TextBlock>

                                            <!-- Cardinal blur taps (radius 2.0px) -->
                                            <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" FontStyle="{Binding FontStyle}" Foreground="{Binding ColorBrush}" Opacity="{Binding BlurOpacity}" TextWrapping="Wrap" TextAlignment="Left" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Left" IsHitTestVisible="False">
                                                <TextBlock.RenderTransform><TranslateTransform X="-2.0" Y="0"/></TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" FontStyle="{Binding FontStyle}" Foreground="{Binding ColorBrush}" Opacity="{Binding BlurOpacity}" TextWrapping="Wrap" TextAlignment="Left" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Left" IsHitTestVisible="False">
                                                <TextBlock.RenderTransform><TranslateTransform X="2.0" Y="0"/></TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" FontStyle="{Binding FontStyle}" Foreground="{Binding ColorBrush}" Opacity="{Binding BlurOpacity}" TextWrapping="Wrap" TextAlignment="Left" FontWeight="Bold" FontFamily="{StaticResource MontserratBold}" HorizontalAlignment="Left" IsHitTestVisible="False">
