                                        </Border>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- ═══════ FOOTER CREDIT ═══════ -->
                        <TextBlock Text="@2026 YTMusicWP v2.3.0 Yasukoisreal" FontSize="11" Foreground="#555555" HorizontalAlignment="Center" Margin="0,30,0,10"/>
