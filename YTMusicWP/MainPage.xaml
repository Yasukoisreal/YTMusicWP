                    <Border x:Name="HomeAvatarFallback" Width="32" Height="32" CornerRadius="16" Background="#1DB954">
                        <TextBlock x:Name="HomeAvatarLetter" Text="Y" FontFamily="{StaticResource MontserratBold}" FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- YouTube profile pic (shown when logged in) -->
                    <Ellipse x:Name="HomeAvatarImage" Width="32" Height="32" Visibility="Collapsed">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="HomeAvatarBrush" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
