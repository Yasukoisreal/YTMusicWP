            </Grid.RowDefinitions>
            <Button Grid.Row="0" Click="ClosePlaylistDetails_Click" Style="{StaticResource IconButtonStyle}" Width="50" Height="50" Margin="10,15,0,0" HorizontalAlignment="Left" Canvas.ZIndex="10">
                <Viewbox Width="20" Height="20"><Path Data="M20,11V13H8L13.5,18.5 12.08,19.92 4.16,12 12.08,4.08 13.5,5.5 8,11H20Z" Fill="White"/></Viewbox>
            </Button>
            <ListView x:Name="PlaylistSongsList" Grid.Row="1" Margin="20,0,20,0" Padding="0" IsItemClickEnabled="True" ItemClick="SongList_ItemClick" SelectionMode="None" ItemTemplate="{StaticResource PlaylistSongItemTemplate}" ItemContainerStyle="{StaticResource StretchItemStyle}" VirtualizingStackPanel.VirtualizationMode="Recycling" ShowsScrollingPlaceholders="False">
                <ListView.Header>
                    <!-- Header cuộn cùng danh sách để giành lại chiều cao cho list trên màn thấp (WVGA 800) -->
