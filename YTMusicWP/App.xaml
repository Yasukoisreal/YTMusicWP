<Application
    x:Class="YTMusicWP.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YTMusicWP"
    xmlns:converters="using:YTMusicWP.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters live here so UserControls can use them via StaticResource -->
            <converters:SquareThumbnailConverter x:Key="SquareThumbConverter"/>
            <converters:IsPlayingToColorConverter x:Key="IsPlayingToColorConverter"/>

            <!-- Fonts live here (not in the merged dictionary) so code can look them up with
                 Application.Current.Resources["..."] and UserControls can use them via StaticResource -->
            <FontFamily x:Key="MontserratRegular">/Assets/Fonts/Montserrat-Regular.ttf#Montserrat</FontFamily>
            <FontFamily x:Key="MontserratMedium">/Assets/Fonts/Montserrat-Medium.ttf#Montserrat</FontFamily>
            <FontFamily x:Key="MontserratSemiBold">/Assets/Fonts/Montserrat-SemiBold.ttf#Montserrat</FontFamily>
            <FontFamily x:Key="MontserratBold">/Assets/Fonts/Montserrat-Bold.ttf#Montserrat</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

</Application>